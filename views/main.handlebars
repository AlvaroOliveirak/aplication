<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="C:\Users\alvar\OneDrive\Documentos\projetos\TSDB\images\favicon.ico" type="image/x-icon">
    <title>Temporal Series Analyser</title>
    
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Goldman:wght@400;700&family=Iceland&family=New+Rocker&family=Zen+Dots&display=swap");
      * {
        margin: 0px;
        padding: 0px;
        box-sizing: border-box;
      }
      body {
        background: linear-gradient(90deg,rgb(31, 1, 51) 0%, rgb(61, 25, 223) 72%, rgb(36, 126, 245) 83%, rgba(1, 0, 46, 1) 100%);
        height: 100vh;

      }
      main{
        align-items: center;
        justify-content: center;
        height: 100%;
      }
      header{
        font-family:
          Zen Dots,
          cursive,
          serif;
      }
      
      #head{
        background: linear-gradient(90deg,rgb(32, 3, 51) 0%, rgba(1, 1, 26, 1) 72%, rgba(0, 25, 99, 1) 83%, rgba(1, 0, 46, 1) 100%);
        color:crimson;
        padding: 5px;
        height: fit-content;
        font-size: 14px;
      }
      nav>a{
        color: antiquewhite;
        text-decoration:none ;
        border-left: 1px solid white;
        border-right: 1px solid whitesmoke;
        padding: 0px 10px 0px 10px ;
      }
      a{
        text-decoration: none;
        color: antiquewhite;
      }
      a:hover{
        text-decoration: underline;
        background-color: rgba(20, 17, 17, 0.658);
        text-shadow: 0.1px 0.1px 4px white ;
        transition-duration: 0.7s;
        cursor: pointer;
      }
      nav{
        display:flex;
        flex-wrap: wrap;
        border: 2px 2px solid whitesmoke;
      }
      #navegation{
        background-color: black;
        width: 100%;
        height: auto;
        font-size: 1.5em ;
        box-shadow: 2px 2px 3px rgba(245, 245, 245, 0.445);
        margin-bottom: 0.35px;
      }
      #titulo{
        margin: auto;
        padding: 10px;
        text-align: center;
        color: antiquewhite;
        text-shadow: 2px 2px 3px rgba(137, 43, 226, 0.342);
        font-family: zen dots, cursive, serif;
      }
      #subtitulo{
        padding: 10px;
        text-align: center;
        color: aliceblue;
        text-shadow: 2px 2px 3px rgba(137, 43, 226, 0.342);
        font-family: zen dots, cursive, serif;
        margin: auto;
        padding-top: 15px ;
      }
      #info{
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
      }
      .info{
        margin: auto 20px auto 20px;
        display: inline-block;
        font-family: 'Zen Dots', cursive, serif;
        font-size: 18px;
        color: aliceblue;
        
      }
      #login{
        display: block;
        margin: auto;
        padding: 10px;
        font-size: 18px;
        font-family: 'Zen Dots', cursive, serif;
        color: aliceblue;
        background-color: transparent;
        border: 2px solid aliceblue;
        border-radius: 5px;
        box-shadow: 2px 2px 3px rgba(245, 245, 245, 0.445);

      }
      
    </style>
  </head>

  <body>
    <header>
      <div id="head">
        
        <h1>Temporal Series</h1>
        
      </div>
    <hr id="headhr" />

    <div id="navegation">
      
      <nav>
        <a href="#">Dashboards</a>
        <a href="#">alguma coisa</a>
        <a href="#">Config</a>
        <a href="#">Design</a>
      </nav>
    </div>
    </header>

    <main>

      <h1 id="titulo">Monitoramento inteligente de séries temporais</h1>
      <h2 id="subtitulo">Detecte anomalias em tempo real e tenha insights valiosos</h2>

      <section id="info">
        <div class="info">
          <p>Análise em tempo real</p>
          <img class="img" src="/aplication/public/images/analisededados.png" alt="amalise de dados">
        </div>
        <div class="info">
          <p>Gráficos interativos</p>
        </div>
        <div class="info">
          <p>Alertas personalizados</p>
        </div>
      </section>
      <button id="login"><a href="localhost:4001/login">Login</a></button>
      




    </main>


    <footer></footer>
  </body>
</html>
