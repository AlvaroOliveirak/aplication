<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Temporal Series</title>
    <link rel="stylesheet" href="/css/page-transition.css">
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Zen+Dots&display=swap");

      :root {
        --bg: #08111f;
        --panel: #101b2b;
        --panel-strong: #142236;
        --line: rgba(151, 164, 184, .18);
        --muted: #91a0b8;
        --text: #f7fbff;
        --teal: #2dd4bf;
        --blue: #60a5fa;
        --shadow: 0 18px 45px rgba(0, 0, 0, .28);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 12% 8%, rgba(45, 212, 191, .12), transparent 26%),
          linear-gradient(140deg, #08111f 0%, #0c1728 52%, #101827 100%);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
      }

      button,
      input {
        font: inherit;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        min-height: 72px;
        padding: 14px 28px;
        background: rgba(8, 17, 31, .88);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(18px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        color: var(--text);
        text-decoration: none;
      }

      .brand-mark {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--teal), var(--blue));
        color: #06111f;
        font-weight: 800;
      }

      .logo {
        font-family: "Zen Dots", Inter, sans-serif;
        font-size: 18px;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .subtitle {
        margin-top: 3px;
        color: var(--muted);
        font-size: 12px;
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
      }

      .nav a,
      .secondary-link,
      .primary-btn {
        min-height: 38px;
        border-radius: 8px;
        color: var(--text);
        cursor: pointer;
        text-decoration: none;
        transition: background .18s ease, border-color .18s ease, color .18s ease, transform .18s ease;
      }

      .nav a,
      .secondary-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 13px;
        background: rgba(255, 255, 255, .04);
        border: 1px solid transparent;
      }

      .nav a:hover,
      .secondary-link:hover {
        background: rgba(255, 255, 255, .08);
        border-color: var(--line);
      }

      .nav .active {
        background: rgba(45, 212, 191, .12);
        border-color: rgba(45, 212, 191, .35);
        color: #bffaf2;
      }

      .auth-page {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 420px;
        gap: 34px;
        align-items: center;
        width: min(1120px, calc(100% - 40px));
        min-height: calc(100vh - 72px);
        margin: 0 auto;
        padding: 44px 0;
      }

      .auth-copy h1 {
        margin: 0 0 14px;
        max-width: 680px;
        font-size: clamp(30px, 5vw, 54px);
        line-height: 1.05;
        letter-spacing: 0;
      }

      .auth-copy p {
        margin: 0;
        max-width: 590px;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
      }

      .signal-strip {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        max-width: 660px;
        margin-top: 28px;
      }

      .signal {
        min-height: 92px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(16, 27, 43, .68);
      }

      .signal strong {
        display: block;
        margin-bottom: 6px;
        font-size: 20px;
      }

      .signal span {
        color: var(--muted);
        font-size: 13px;
      }

      .auth-card {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: linear-gradient(180deg, rgba(20, 34, 54, .94), rgba(13, 24, 39, .94));
        box-shadow: var(--shadow);
        padding: 24px;
      }

      .auth-card h2 {
        margin: 0 0 6px;
        font-size: 24px;
      }

      .auth-card p {
        margin: 0 0 22px;
        color: var(--muted);
        line-height: 1.5;
      }

      .field {
        display: grid;
        gap: 8px;
        margin-bottom: 16px;
      }

      .field label {
        color: #dce7f8;
        font-size: 13px;
        font-weight: 700;
      }

      .field input {
        width: 100%;
        min-height: 46px;
        padding: 0 13px;
        border: 1px solid rgba(151, 164, 184, .25);
        border-radius: 8px;
        outline: none;
        background: rgba(5, 12, 23, .52);
        color: var(--text);
      }

      .field input:focus {
        border-color: rgba(45, 212, 191, .68);
        box-shadow: 0 0 0 3px rgba(45, 212, 191, .12);
      }

      .primary-btn {
        width: 100%;
        min-height: 46px;
        border: 0;
        background: linear-gradient(135deg, var(--teal), var(--blue));
        color: #06111f;
        font-weight: 800;
      }

      .primary-btn:hover {
        transform: translateY(-1px);
      }

      .google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 46px;
        margin-top: 12px;
        border: 1px solid rgba(151, 164, 184, .28);
        border-radius: 8px;
        background: rgba(255, 255, 255, .06);
        color: var(--text);
        font-weight: 800;
        text-decoration: none;
      }

      .auth-switch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 18px;
        color: var(--muted);
        font-size: 14px;
      }

      @media (max-width: 840px) {
        .topbar {
          align-items: flex-start;
          flex-direction: column;
          padding: 14px 18px;
        }

        .nav {
          justify-content: flex-start;
        }

        .auth-page {
          grid-template-columns: 1fr;
          width: min(100% - 28px, 520px);
          padding: 30px 0;
        }

        .signal-strip {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <div class="brand-mark">TS</div>
        <div>
          <div class="logo">Prom_TS</div>
          <div class="subtitle">Observabilidade e alertas</div>
        </div>
      </a>

      <nav class="nav" aria-label="Navegacao principal">
        <a href="/">Inicio</a>
        <a class="active" href="/login">Login</a>
        <a href="/register">Registro</a>
        <a href="/dashboard">Dashboard</a>
      </nav>
    </header>

    <main class="auth-page">
      <section class="auth-copy">
        <h1>Entre para acompanhar suas metricas em tempo real.</h1>
        <p>Continue para o painel de Dashboards com thresholds e historico de alertas no mesmo fluxo visual.</p>

        <div class="signal-strip" aria-label="Resumo do sistema">
          <div class="signal">
            <strong>5m</strong>
            <span>Janelas moveis por card</span>
          </div>
          <div class="signal">
            <strong>CPU</strong>
            <span>Thresholds por metrica</span>
          </div>
          <div class="signal">
            <strong>Live</strong>
            <span>Refresh automatico</span>
          </div>
        </div>
      </section>

      <section class="auth-card" aria-labelledby="login-title">
        <h2 id="login-title">Login</h2>
        <p>Acesse sua area de monitoramento.</p>

        <div id="errorMessage" style="display: none; padding: 12px; margin-bottom: 16px; border-radius: 8px; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.34); color: #fecaca; font-size: 14px;"></div>

        <form id="loginForm" action="/login" method="POST">
<script>
  const urlParams = new URLSearchParams(window.location.search);
  const redirectTo = urlParams.get('redirectTo');
  if (redirectTo) {
    document.getElementById('loginForm').action = `/login?redirectTo=${encodeURIComponent(redirectTo)}`;
  }
</script>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" placeholder="voce@empresa.com" required>
          </div>

          <div class="field">
            <label for="password">Senha</label>
            <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Sua senha" required>
          </div>

          <button class="primary-btn" type="submit">Entrar</button>
        </form>

        <a class="google-btn" href="/auth/google">Entrar com Google</a>

        <div class="auth-switch">
          <span>Novo por aqui?</span>
          <a class="secondary-link" href="/register">Criar conta</a>
        </div>
      </section>
    </main>
    <script>
      const errorMap = {
        'google': 'Falha ao autenticar com Google. Tente novamente.',
        'invalid-email-format': 'Estrutura de e-mail incorreta. Digite um e-mail válido no formato usuario@dominio.com.',
        'email-not-found': 'Este e-mail não está cadastrado no sistema. Verifique o endereço digitado ou crie uma conta.',
        'incorrect-password': 'Senha incorreta para este e-mail. Verifique a senha e tente novamente.',
        'social-account-only': 'Esta conta foi criada via Google. Clique em "Entrar com Google" abaixo.',
        'invalid-credentials': 'E-mail ou senha incorretos.',
        'login-failed': 'Erro interno ao realizar login. Tente novamente.'
      };
      
      const urlParams = new URLSearchParams(window.location.search);
      const error = urlParams.get('error');
      const registered = urlParams.get('registered');
      const errorMsg = document.getElementById('errorMessage');
      
      if (error && errorMap[error]) {
        errorMsg.textContent = errorMap[error];
        errorMsg.style.display = 'block';
      } else if (registered === '1') {
        errorMsg.textContent = 'Conta criada com sucesso! Faça login para continuar.';
        errorMsg.style.background = 'rgba(34, 197, 94, 0.12)';
        errorMsg.style.borderColor = 'rgba(34, 197, 94, 0.34)';
        errorMsg.style.color = '#bbf7d0';
        errorMsg.style.display = 'block';
      }
    </script>
    <script src="/js/page-transition.js"></script>
  </body>
</html>
