<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Temporal Series Analyser</title>
  <link rel="stylesheet" href="../public/css/style.css">

   <style>
    @import url("https://fonts.googleapis.com/css2?family=Goldman:wght@400;700&family=Iceland&family=New+Rocker&family=Zen+Dots&display=swap");

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      min-height:100vh;
      background:#0b1120;
      background:  radial-gradient(circle at top left,#1e3a8a 0%,transparent 30%),radial-gradient(circle at bottom right,#7c3aed 0%,transparent 25%),
#0b1120;
      font-family: Arial, Helvetica, sans-serif;
    }

    header{
      font-family: "Zen Dots", cursive, serif;
    }

    #head{
      color: rgb(27, 118, 204);
      padding: 8px 15px;
      font-size: 14px;
      border-bottom: 1px solid rgb(159, 156, 197);
    }

    #navegation{
      background:black;
      width:100%;
      box-shadow:2px 2px 3px rgba(245,245,245,.25);
    }

    nav{
      display:flex;
      flex-wrap:wrap;
      justify-content:center;
      gap:15px;
      padding:15px;
    }

    nav a{
      color: antiquewhite;
      text-decoration:none;
      padding:8px 14px;
      border-left:1px solid white;
      border-right:1px solid whitesmoke;
      transition:.3s;
    }

    nav a:hover{
      background:rgba(255,255,255,.08);
      text-shadow:0 0 5px white;
      border-radius:8px;
      
    }

    main{
      max-width:1200px;
      margin:auto;
      padding:40px 20px;
      text-align:center;
    }

    #titulo{
      color:antiquewhite;
      font-family:"Zen Dots", cursive;
      margin-bottom:15px;
    }

    #subtitulo{
      color:#fff;
      font-family:"Zen Dots", cursive;
      margin-bottom:40px;
      font-size:18px;
    }

    /* CARDS */
    #info{
      display:flex;
      flex-wrap:wrap;
      justify-content:center;
      gap:20px;
      margin-bottom:40px;
    }

    .info{
      min-width:220px;
      padding:25px;
      color:white;
      font-family:"Zen Dots", cursive;
      border-radius:18px;

      background:rgba(255,255,255,.10);
      border:1px solid rgba(255,255,255,.18);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);

      box-shadow:0 8px 25px rgba(0,0,0,.25);
      transition:.35s ease;
    }

    .info:hover{
      transform:translateY(-8px) scale(1.03);
      background:rgba(255,255,255,.16);
      box-shadow:0 15px 35px rgba(0,0,0,.35);
    }

    /* FORMULÁRIO */
    .form-box{
      max-width:420px;
      margin:0 auto;
      padding:30px;
      border-radius:20px;

      background:rgba(255,255,255,.10);
      border:1px solid rgba(255,255,255,.18);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);

      box-shadow:0 10px 30px rgba(0,0,0,.30);
    }

    .form-box input{
      width:100%;
      padding:14px 16px;
      margin-bottom:16px;
      border:none;
      outline:none;
      border-radius:12px;
      font-size:15px;
      background:rgba(255,255,255,.15);
      color:white;
    }

    .form-box input::placeholder{
      color:rgba(255,255,255,.75);
    }

    #reg{
      width:100%;
      padding:14px;
      border:none;
      border-radius:12px;
      font-size:16px;
      font-weight:bold;
      background:linear-gradient(90deg,#6a00ff,#9d00ff);
      color:white;
      cursor:pointer;
      transition:.3s;
    }

    #reg:hover{
      transform:translateY(-3px);
      box-shadow:0 10px 20px rgba(0,0,0,.35);
    }

    #reg a{
      color:white;
      text-decoration:none;
      display:block;
      width:100%;
      height:100%;
    }

  </style>
</head>

<body>

<header>
  <div id="head">
    <h1>Temporal Series</h1>
  </div>

 
</header>

<main>

  <h1 id="titulo">Monitoramento inteligente de séries temporais</h1>
  <h2 id="subtitulo">
    Detecte anomalias em tempo real e tenha insights valiosos
  </h2>

  <section id="info">
    <div class="info">Análise em tempo real</div>
    <div class="info">Gráficos interativos</div>
    <div class="info">Alertas personalizados</div>
  </section>
<form action="/register" method="POST">
  
    <section class="form-box">
      <input type="email" id="email" name="email" placeholder="Digite seu email" required>
      <input type="password" id="password" name="password" placeholder="Digite sua senha" required>
  
      <button type="submit" id="reg">Register</button>
    </section>
</form>

</main>

</body>

</html> 


