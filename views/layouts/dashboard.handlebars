<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Temporal Series</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/page-transition.css">
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Zen+Dots&display=swap");

      :root {
        --bg: #08111f;
        --panel: #101b2b;
        --panel-strong: #142236;
        --line: rgba(151, 164, 184, .18);
        --muted: #91a0b8;
        --text: #f7fbff;
        --teal: #2dd4bf;
        --green: #22c55e;
        --amber: #f59e0b;
        --red: #ef4444;
        --blue: #60a5fa;
        --shadow: 0 18px 45px rgba(0, 0, 0, .28);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 12% 8%, rgba(45, 212, 191, .12), transparent 26%),
          linear-gradient(140deg, #08111f 0%, #0c1728 52%, #101827 100%);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
      }

      body[data-theme="light"] {
        --bg: #e6edf1;
        --panel: #f3f7f8;
        --panel-strong: #eaf1f3;
        --line: rgba(55, 74, 96, .18);
        --muted: #5d6f82;
        --text: #172235;
        --shadow: 0 16px 38px rgba(31, 42, 68, .09);
        background:
          radial-gradient(circle at 18% 8%, rgba(20, 184, 166, .08), transparent 28%),
          radial-gradient(circle at 88% 0%, rgba(96, 165, 250, .07), transparent 28%),
          linear-gradient(140deg, #e6edf1 0%, #dfe9e8 54%, #e8edf2 100%);
      }

      body[data-theme="light"] .topbar,
      body[data-theme="light"] .sidebar {
        background: rgba(241, 246, 247, .82);
      }

      body[data-theme="light"] .panel,
      body[data-theme="light"] .card {
        background: linear-gradient(180deg, rgba(247, 250, 251, .90), rgba(235, 242, 244, .90));
      }

      body[data-theme="light"] .nav a,
      body[data-theme="light"] .nav button,
      body[data-theme="light"] .ghost-btn,
      body[data-theme="light"] .metric-btn,
      body[data-theme="light"] .range-btn,
      body[data-theme="light"] .icon-btn {
        background: rgba(255, 255, 255, .52);
        color: #172235;
      }

      body[data-theme="light"] .nav .active,
      body[data-theme="light"] .range-btn.active,
      body[data-theme="light"] .metric-btn.active {
        background: rgba(20, 184, 166, .13);
        border-color: rgba(15, 118, 110, .28);
        color: #0f766e;
      }

      button,
      input {
        font: inherit;
      }

      button {
        border: 0;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        min-height: 72px;
        padding: 14px 28px;
        background: rgba(8, 17, 31, .88);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(18px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        color: var(--text);
        text-decoration: none;
      }

      .brand-mark {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--teal), var(--blue));
        color: #06111f;
        font-weight: 800;
      }

      .logo {
        font-family: "Zen Dots", Inter, sans-serif;
        font-size: 18px;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .subtitle {
        margin-top: 3px;
        color: var(--muted);
        font-size: 12px;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav a,
      .nav button,
      .ghost-btn,
      .primary-btn,
      .icon-btn,
      .range-btn,
      .metric-btn {
        min-height: 38px;
        border-radius: 8px;
        color: var(--text);
        cursor: pointer;
        text-decoration: none;
        transition: background .18s ease, border-color .18s ease, color .18s ease, transform .18s ease;
      }

      .nav a,
      .nav button,
      .ghost-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 13px;
        background: rgba(255, 255, 255, .04);
        border: 1px solid transparent;
      }

      .nav a:hover,
      .nav button:hover,
      .ghost-btn:hover {
        background: rgba(255, 255, 255, .08);
        border-color: var(--line);
      }

      .nav .active {
        background: rgba(45, 212, 191, .12);
        border-color: rgba(45, 212, 191, .35);
        color: #bffaf2;
      }

      .dashboard {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        min-height: calc(100vh - 72px);
      }

      .sidebar {
        padding: 22px;
        border-right: 1px solid var(--line);
        background: rgba(8, 17, 31, .42);
      }

      .main {
        min-width: 0;
        padding: 26px;
        overflow: auto;
      }

      .overview {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
      }

      .overview-item {
        min-height: 92px;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(255, 255, 255, .045);
      }

      .overview-item span {
        color: var(--muted);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
      }

      .overview-item strong {
        display: block;
        margin-top: 8px;
        font-size: 28px;
      }

      .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
      }

      .eyebrow {
        margin: 0 0 6px;
        color: var(--teal);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      h4,
      p {
        margin-top: 0;
      }

      h1 {
        margin-bottom: 0;
        font-size: clamp(26px, 3vw, 38px);
        letter-spacing: 0;
      }

      h3 {
        margin-bottom: 12px;
        font-size: 15px;
      }

      h4 {
        margin: 0;
        font-size: 16px;
      }

      .muted {
        color: var(--muted);
      }

      .panel,
      .card {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: linear-gradient(180deg, rgba(20, 34, 54, .92), rgba(13, 24, 39, .92));
        box-shadow: var(--shadow);
      }

      .panel {
        padding: 16px;
        margin-bottom: 16px;
      }

      .card {
        padding: 18px;
        overflow: hidden;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 18px;
      }

      .builder {
        margin-bottom: 18px;
      }

      .builder-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
      }

      .primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 16px;
        background: linear-gradient(135deg, #14b8a6, #60a5fa);
        color: #05101d;
        font-weight: 800;
      }

      .primary-btn:hover,
      .icon-btn:hover,
      .range-btn:hover,
      .metric-btn:hover {
        transform: translateY(-1px);
      }

      #metricMenu {
        display: none;
        margin-top: 14px;
        padding: 14px;
        border-top: 1px solid var(--line);
        opacity: 0;
        transform: translateY(-8px);
        transition: .24s ease;
      }

      #metricMenu.show {
        opacity: 1;
        transform: translateY(0);
      }

      #metricOptions {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(135px, 1fr));
        gap: 10px;
        margin-bottom: 12px;
      }

      .metric-btn,
      .range-btn {
        background: rgba(255, 255, 255, .05);
        border: 1px solid var(--line);
      }

      .metric-btn {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 11px;
        color: #dce7f7;
        font-weight: 700;
        text-align: left;
      }

      .metric-btn.active {
        background: rgba(45, 212, 191, .13);
        border-color: rgba(45, 212, 191, .48);
        color: #d9fffb;
      }

      .range-buttons {
        display: flex;
        gap: 8px;
        margin: 14px 0 10px;
        flex-wrap: wrap;
      }

      .range-btn {
        min-height: 32px;
        padding: 0 11px;
        color: #cdd8ea;
        font-size: 12px;
        font-weight: 800;
      }

      .range-btn.active {
        background: rgba(96, 165, 250, .16);
        border-color: rgba(96, 165, 250, .5);
        color: #eaf4ff;
      }

      .chart-header,
      .item-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
      }

      .card-actions {
        display: flex;
        gap: 7px;
        flex-shrink: 0;
      }

      .icon-btn {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        background: rgba(255, 255, 255, .06);
        border: 1px solid var(--line);
        color: #e9f2ff;
        font-weight: 800;
      }

      .icon-btn.danger {
        background: rgba(239, 68, 68, .12);
        border-color: rgba(239, 68, 68, .34);
        color: #fecaca;
      }

      .chart-box {
        height: 320px;
        min-width: 0;
      }

      .alert-inline {
        display: none;
        gap: 12px;
        margin-top: 10px;
        padding-top: 12px;
        border-top: 1px solid var(--line);
      }

      .threshold-form {
        display: grid;
        gap: 10px;
      }

      .threshold-form legend {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      .threshold-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .threshold-field label {
        display: block;
        margin-bottom: 6px;
        color: #dce7f8;
        font-size: 12px;
        font-weight: 700;
      }

      .threshold-field label.warning-label {
        color: #fcd34d;
      }

      .threshold-field label.critical-label {
        color: #fca5a5;
      }

      .thresholdInput {
        width: 100%;
        min-height: 40px;
        padding: 0 12px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, .07);
        color: var(--text);
        outline: none;
      }

      .thresholdInput:focus {
        border-color: rgba(45, 212, 191, .62);
      }

      .control-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 10px;
        margin-top: 12px;
      }

      .control-field {
        display: grid;
        gap: 6px;
      }

      .control-field label {
        color: #dce7f8;
        font-size: 12px;
        font-weight: 800;
      }

      body[data-theme="light"] .control-field label {
        color: #25344a;
      }

      .control-field input,
      .control-field select,
      .custom-query {
        width: 100%;
        min-height: 40px;
        padding: 0 11px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, .07);
        color: var(--text);
        outline: none;
      }

      .control-field select option {
        background: #101b2b;
        color: #f7fbff;
      }

      body[data-theme="light"] .control-field input,
      body[data-theme="light"] .control-field select,
      body[data-theme="light"] .custom-query {
        background: rgba(255, 255, 255, .84);
        color: #132033;
      }

      body[data-theme="light"] .control-field select option {
        background: #f8fbfc;
        color: #132033;
      }

      .custom-query {
        margin-top: 12px;
        font-family: Consolas, monospace;
      }

      .stat-card {
        display: grid;
        align-content: center;
        min-height: 300px;
        padding: 18px;
      }

      .stat-value {
        font-size: clamp(42px, 7vw, 76px);
        line-height: 1;
        font-weight: 800;
      }

      .stat-label {
        margin-top: 10px;
        color: var(--muted);
        font-weight: 700;
      }

      .threshold-item,
      .alert-live,
      .log {
        padding: 12px;
        margin-bottom: 10px;
        border-radius: 8px;
        background: rgba(255, 255, 255, .055);
        border: 1px solid var(--line);
        border-left-width: 4px;
        font-size: 13px;
        transition: border-color .2s ease, background .2s ease;
      }

      .threshold-item.status-OK {
        border-left-color: #22c55e;
        background: rgba(34, 197, 94, .08);
      }

      .threshold-item.status-WARNING {
        border-left-color: #f59e0b;
        background: rgba(245, 158, 11, .1);
      }

      .threshold-item.status-CRITICAL {
        border-left-color: #ef4444;
        background: rgba(239, 68, 68, .12);
      }

      .delete-threshold-btn {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: rgba(239, 68, 68, .12);
        color: #fecaca;
        cursor: pointer;
      }

      .alert-live {
        animation: pulse 1.8s infinite;
      }

      .alert-ok {
        border-color: rgba(34, 197, 94, .36);
      }

      .alert-warning {
        border-color: rgba(245, 158, 11, .46);
        background: rgba(245, 158, 11, .11);
      }

      .alert-critical {
        border-color: rgba(239, 68, 68, .5);
        background: rgba(239, 68, 68, .12);
      }

      .logs {
        display: grid;
        gap: 10px;
        max-height: none;
        overflow: visible;
      }

      .log {
        display: grid;
        grid-template-columns: 110px minmax(0, 1fr) auto;
        gap: 14px;
        align-items: center;
        margin: 0;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 26px;
        padding: 0 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
      }

      .status-OK {
        background: rgba(34, 197, 94, .12);
        color: #bbf7d0;
      }

      .status-WARNING {
        background: rgba(245, 158, 11, .14);
        color: #fde68a;
      }

      .status-CRITICAL {
        background: rgba(239, 68, 68, .15);
        color: #fecaca;
      }

      .empty-state {
        display: grid;
        place-items: center;
        min-height: 160px;
        border: 1px dashed var(--line);
        border-radius: 8px;
        color: var(--muted);
        text-align: center;
        padding: 18px;
      }

      @keyframes pulse {
        0%, 100% {
          transform: scale(1);
        }

        50% {
          transform: scale(1.015);
        }
      }

      @media (max-width: 880px) {
        .topbar,
        .section-head,
        .builder-bar {
          align-items: stretch;
          flex-direction: column;
        }

        .nav {
          justify-content: flex-start;
        }

        .dashboard {
          grid-template-columns: 1fr;
        }

        .sidebar {
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .main {
          padding: 18px;
        }

        .grid {
          grid-template-columns: 1fr;
        }

        .overview {
          grid-template-columns: 1fr;
        }

        .log {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body data-theme="{{theme}}">
    <header class="topbar">
      <a class="brand" href="/">
        <div class="brand-mark">TS</div>
        <div>
          <div class="logo">Prom_TS</div>
          <div class="subtitle">Monitoramento Prometheus em tempo real</div>
        </div>
      </a>

<nav class="nav" aria-label="Navegacao principal">
        <a href="/">Inicio</a>
        <button class="active" data-tab-button="dashboards" onclick="showTab('dashboards')">Dashboard</button>
        <button data-tab-button="logs" onclick="showTab('logs')">Logs</button>
        <button data-tab-button="settings" onclick="showTab('settings')">Config</button>
        {{#if user}}
          <a href="/logout">Sair</a>
        {{/if}}
      </nav>
    </header>

    <div class="dashboard">
      <aside class="sidebar">
        <div class="panel">
          <h3>Thresholds ativos</h3>
          <div id="thresholdList"></div>
        </div>

        <div class="panel">
          <h3>Alertas em aberto</h3>
          <div id="alertFeed"></div>
        </div>
      </aside>

      <main class="main">
        <section id="dashboards">
          <div class="section-head">
            <div>
              <p class="eyebrow">Metricas</p>
              <h1>Dashboards</h1>
            </div>
            <div class="muted" id="refreshStatus">Atualizacao automatica ativa.</div>
          </div>

          <div class="overview" aria-label="Resumo dos dashboards">
            <div class="overview-item">
              <span>Dashboards</span>
              <strong id="dashboardCount">0</strong>
            </div>
            <div class="overview-item">
              <span>Alertas ativos</span>
              <strong id="activeAlertCount">0</strong>
            </div>
            <div class="overview-item">
              <span>Refresh</span>
              <strong id="refreshSummary">5s</strong>
            </div>
          </div>

          <div class="builder panel">
            <div class="builder-bar">
              <div>
                <h3>Selecionar dashboards</h3>
                <div class="muted">Escolha as métricas que voce quer acompanhar.</div>
              </div>
              <button class="primary-btn" onclick="toggleMetricMenu()">Selecionar</button>
            </div>

            <div id="metricMenu">
              <div id="metricOptions"></div>
              <input id="customQueryInput" class="custom-query" type="text" placeholder="Cole uma query Prometheus personalizada">
              <button class="primary-btn" onclick="createSelectedCharts()">Criar dashboards</button>
            </div>
          </div>

          <div class="grid" id="chartsContainer"></div>
        </section>

        <section id="logs" style="display:none;">
          <div class="section-head">
            <div>
              <p class="eyebrow">Historico</p>
              <h1>Logs de alertas</h1>
            </div>
            <button class="ghost-btn" onclick="loadAlertLogs()">Atualizar logs</button>
          </div>

          <div class="panel">
            <div class="logs" id="logContainer"></div>
          </div>
        </section>

        <section id="settings" style="display:none;">
          <div class="section-head">
            <div>
              <p class="eyebrow">Preferencias</p>
              <h1>Configuracoes</h1>
            </div>
          </div>

          <div class="panel">
            <h3>Visualizacao</h3>
            <p class="muted">Os graficos usam janelas independentes por card, refresh automatico, anomalias por z-score e media movel.</p>
            <div class="control-grid">
              <div class="control-field">
                <label for="refreshIntervalInput">Atualizar dashboards a cada</label>
                <select id="refreshIntervalInput" onchange="updateRefreshInterval()">
                  <option value="3000">3 segundos</option>
                  <option value="5000">5 segundos</option>
                  <option value="10000">10 segundos</option>
                  <option value="30000">30 segundos</option>
                  <option value="60000">1 minuto</option>
                </select>
              </div>
              <div class="control-field">
                <label>Tema</label>
                <button class="ghost-btn" onclick="toggleTheme()">Alternar tema claro/escuro</button>
              </div>
              <div class="control-field">
                <label>Email de alertas</label>
                <button class="ghost-btn" onclick="sendTestEmail()">Enviar email de teste</button>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
    <script>
      let metricList = [
        {
          id: "ram",
          name: "RAM",
          query: "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))"
        },
        {
          id: "cpu",
          name: "CPU",
          query: "100 * (1 - avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))"
        },
        {
          id: "disco",
          name: "Disco (%)",
          query: "100 * (1 - (node_filesystem_avail_bytes / node_filesystem_size_bytes))"
        },
        {
          id: "rede_rx",
          name: "Rede RX",
          query: "rate(node_network_receive_bytes_total[5m])"
        },
        {
          id: "rede_tx",
          name: "Rede TX",
          query: "rate(node_network_transmit_bytes_total[5m])"
        },
        {
          id: "load_1m",
          name: "Load 1m",
          query: "node_load1"
        },
        {
          id: "load_5m",
          name: "Load 5m",
          query: "node_load5"
        }
      ];

      let selectedMetrics = new Set();
      const activeDashboards = new Set();
      const socket = io();

      socket.on("alert:created", () => {
        loadThresholds();
        loadAlertFeed();
        loadAlertLogs();
      });

      function resolveThresholds(alert) {
        const criticalThreshold = Number(alert?.criticalThreshold ?? alert?.threshold);
        const warningThreshold = Number(
          alert?.warningThreshold ?? (Number.isFinite(criticalThreshold) ? criticalThreshold * 0.8 : NaN)
        );

        return { warningThreshold, criticalThreshold };
      }

      function statusColor(status) {
        if (status === "CRITICAL") {
          return "#fca5a5";
        }

        if (status === "WARNING") {
          return "#fcd34d";
        }

        return "#86efac";
      }

      function buildThresholdMarkLines(thresholdData) {
        if (!thresholdData) {
          return undefined;
        }

        const { warningThreshold, criticalThreshold } = resolveThresholds(thresholdData);
        const unit = thresholdData.unit || "%";

        return {
          silent: true,
          symbol: ["none", "none"],
          data: [
            {
              yAxis: warningThreshold,
              lineStyle: {
                color: "#f59e0b",
                width: 2,
                type: "dashed"
              },
              label: {
                show: true,
                position: "end",
                formatter: `Atencao ${warningThreshold}${unit}`,
                color: "#fff",
                fontSize: 11,
                fontWeight: "bold",
                backgroundColor: "rgba(245,158,11,.9)",
                padding: [4, 7],
                borderRadius: 6
              }
            },
            {
              yAxis: criticalThreshold,
              lineStyle: {
                color: "#ef4444",
                width: 2,
                type: "dashed"
              },
              label: {
                show: true,
                position: "end",
                formatter: `Alerta ${criticalThreshold}${unit}`,
                color: "#fff",
                fontSize: 11,
                fontWeight: "bold",
                backgroundColor: "rgba(239,68,68,.9)",
                padding: [4, 7],
                borderRadius: 6
              }
            }
          ]
        };
      }

      function getMetricDefinitionByQuery(query) {
        return metricList.find(metric => metric.query === query);
      }

      function resolveMetricId(query, metricId) {
        if (metricId && metricId !== "undefined" && metricId !== "null") {
          return metricId;
        }

        return getMetricDefinitionByQuery(query)?.id || query;
      }

      function emptyState(message) {
        return `<div class="empty-state">${message}</div>`;
      }

      function formatNumber(value) {
        const number = Number(value);
        return Number.isFinite(number) ? number.toFixed(2) : "-";
      }

      function formatInterval(ms) {
        const seconds = Math.round(Number(ms) / 1000);
        return seconds >= 60 ? `${Math.round(seconds / 60)}min` : `${seconds}s`;
      }

      async function removeDashboardByQuery(query) {
        document.querySelectorAll(".card[data-query]").forEach(card => {
          if (card.dataset.query === query) {
            const chart = echarts.getInstanceByDom(card.querySelector("[data-chart-id]"));
            chart?.dispose();
            card.remove();
          }
        });

        activeDashboards.delete(query);
      }

      function toggleMetricMenu() {
        const menu = document.getElementById("metricMenu");

        if (menu.style.display === "none" || !menu.style.display) {
          menu.style.display = "block";
          requestAnimationFrame(() => menu.classList.add("show"));
        } else {
          menu.classList.remove("show");
          setTimeout(() => {
            menu.style.display = "none";
          }, 240);
        }

        renderMetricOptions();
      }

      function renderMetricOptions() {
        const container = document.getElementById("metricOptions");
        container.innerHTML = "";

        metricList.forEach(metric => {
          const btn = document.createElement("button");
          const isActive = selectedMetrics.has(metric.query) || activeDashboards.has(metric.query);
          btn.className = `metric-btn${isActive ? " active" : ""}`;
          btn.innerHTML = `<span>${metric.name}</span><span>${isActive ? "Ativo" : "Adicionar"}</span>`;

          btn.onclick = async () => {
            if (activeDashboards.has(metric.query)) {
              await removeDashboardByQuery(metric.query);
            } else if (selectedMetrics.has(metric.query)) {
              selectedMetrics.delete(metric.query);
            } else {
              selectedMetrics.add(metric.query);
            }

            renderMetricOptions();
          };

          container.appendChild(btn);
        });
      }

      async function createSelectedCharts() {
        const customQuery = document.getElementById("customQueryInput")?.value.trim();

        if (customQuery) {
          const inferredResponse = await fetch("/api/metrics/infer", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({ query: customQuery })
          });
          const inferred = await inferredResponse.json();
          metricList = metricList.filter(metric => metric.query !== customQuery);
          metricList.push({
            id: inferred.id || customQuery,
            name: inferred.name || resolveMetricName(customQuery, []),
            query: customQuery,
            unit: inferred.unit || ""
          });
          selectedMetrics.add(customQuery);
          document.getElementById("customQueryInput").value = "";
        }

        if (selectedMetrics.size === 0) {
          return;
        }

        for (const query of selectedMetrics) {
          if (activeDashboards.has(query)) {
            continue;
          }

          const metric = metricList.find(m => m.query === query);
          const response = await fetch("/api/dashboard", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              query,
              metricId: metric?.id || query,
              chartType: "line",
              aggregation: "none"
            })
          });

          const dashboard = await response.json();
          await renderSavedChart(dashboard);
          activeDashboards.add(query);
        }

        selectedMetrics.clear();
        renderMetricOptions();
      }

      function showTab(tab) {
        document.querySelectorAll("main section").forEach(s => s.style.display = "none");
        document.getElementById(tab).style.display = "block";

        document.querySelectorAll("[data-tab-button]").forEach(button => {
          button.classList.toggle("active", button.dataset.tabButton === tab);
        });

        if (tab === "logs") {
          loadAlertLogs();
        }
      }

      async function deleteDashboard(id, btn) {
        const card = btn.closest(".card");
        const query = card.dataset.query;

        await fetch(`/api/dashboard/${id}`, {
          method: "DELETE"
        });

        const chart = echarts.getInstanceByDom(card.querySelector("[data-chart-id]"));
        chart?.dispose();
        card.remove();
        activeDashboards.delete(query);
        document.getElementById("dashboardCount").textContent = String(document.querySelectorAll(".card[data-query]").length);
        renderMetricOptions();
      }

      function beautifyMetric(name) {
        return name
          .replace(/node_/g, "")
          .replace(/_seconds_total/g, "")
          .replace(/_/g, " ")
          .replace(/\b\w/g, l => l.toUpperCase());
      }

      function resolveMetricName(query, data) {
        const q = query.toLowerCase();

        if (q.includes("node_cpu_seconds_total") && q.includes("rate") && q.includes("idle")) {
          return "Uso de CPU (%)";
        }

        if (q.includes("node_memory_memavailable_bytes") && q.includes("node_memory_memtotal_bytes")) {
          return "Uso de Memoria (%)";
        }

        if (q.includes("node_filesystem_size_bytes") && q.includes("node_filesystem_avail_bytes")) {
          return "Uso de Disco (%)";
        }

        if (q.includes("node_network_receive_bytes_total")) {
          return "Entrada de Rede (RX)";
        }

        if (q.includes("node_network_transmit_bytes_total")) {
          return "Saida de Rede (TX)";
        }

        if (q.includes("node_load1")) {
          return "Load Average (1m)";
        }

        if (q.includes("node_load5")) {
          return "Load Average (5m)";
        }

        if (data[0]?.metric?.__name__) {
          return beautifyMetric(data[0].metric.__name__);
        }

        return beautifyMetric(query);
      }

      async function renderSavedChart(dashboard) {
        try {
          const res = await fetch("/api/query", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
