<!doctype html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard | Temporal Series</title>
<link rel="stylesheet" href="/css/style.css">

<style>
body{
  background:#0b1120;
  color:white;
  font-family: Arial, Helvetica, sans-serif;
}

/* HEADER */
header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:15px 30px;
  border-bottom:1px solid rgba(255,255,255,.1);
}

.logo{
  font-family:"Zen Dots";
  font-size:20px;
}

nav a{
  color:white;
  margin-left:20px;
  text-decoration:none;
}

/* LAYOUT */
.dashboard{
  display:grid;
  grid-template-columns: 250px 1fr;
  height: calc(100vh - 70px);
}

/* SIDEBAR */
.sidebar{
  border-right:1px solid rgba(255,255,255,.1);
  padding:20px;
}

.sidebar button{
  width:100%;
  margin-bottom:10px;
  padding:12px;
  border:none;
  border-radius:10px;
  background:rgba(255,255,255,.1);
  color:white;
  cursor:pointer;
}

.sidebar button:hover{
  background:rgba(255,255,255,.2);
}

/* MAIN */
.main{
  padding:20px;
  overflow:auto;
}

/* GRID DASHBOARDS */
.grid{
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(300px,1fr));
  gap:20px;
}

/* CARD */
.card{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.15);
  border-radius:16px;
  padding:15px;
  backdrop-filter: blur(12px);
}

/* BUILDER */
.builder{
  margin-bottom:20px;
}

.builder input{
  width:70%;
  padding:12px;
  border-radius:10px;
  border:none;
  margin-right:10px;
}

.builder button{
  padding:12px 20px;
  border:none;
  border-radius:10px;
  background:linear-gradient(90deg,#6a00ff,#9d00ff);
  color:white;
  cursor:pointer;
}

/* ALERT CONFIG */
.alert-box input{
  width:100%;
  margin-bottom:10px;
  padding:10px;
  border-radius:8px;
  border:none;
}

/* LOGS */
.logs{
  max-height:200px;
  overflow:auto;
}

.log{
  padding:10px;
  margin-bottom:8px;
  border-radius:8px;
  background:rgba(255,0,0,.2);
  position:relative;
}

.log:hover::after{
  content: attr(data-help);
  position:absolute;
  top:100%;
  left:0;
  background:black;
  padding:10px;
  border-radius:8px;
  font-size:12px;
  width:250px;
}

</style>
</head>

<body>

<header>
  <div class="logo">Temporal Series</div>
  <nav>
    <a href="/">Home</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/config">Config</a>
  </nav>
</header>

<div class="dashboard">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <button onclick="showTab('dashboards')">Dashboards</button>
    <button onclick="showTab('alerts')">Alertas</button>
    <button onclick="showTab('logs')">Logs</button>
    <button onclick="showTab('settings')">Configurações</button>
  </aside>

  <!-- MAIN -->
  <main class="main">

    <!-- DASHBOARDS -->
    <section id="dashboards">

      <div class="builder">
        <input id="queryInput" placeholder="Ex: 100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))">
        <button onclick="createChart()">Criar gráfico</button>
      </div>

      <div class="grid" id="chartsContainer">
        <!-- gráficos serão inseridos aqui -->
      </div>

    </section>

    <!-- ALERTS -->
    <section id="alerts" style="display:none">
      <div class="card alert-box">
        <h3>Criar alerta</h3>

        <input id="metric" placeholder="Métrica (ex: cpu_usage)">
        <input id="threshold" placeholder="Threshold (%) ex: 80">
        
        <button onclick="createAlert()">Salvar alerta</button>
      </div>
    </section>

    <!-- LOGS -->
    <section id="logs" style="display:none">
      <div class="card">
        <h3>Logs de Alertas</h3>

        <div class="logs" id="logContainer">
          <!-- logs -->
        </div>

      </div>
    </section>

    <!-- SETTINGS -->
    <section id="settings" style="display:none">
      <div class="card">
        <h3>Configurações</h3>
        <p>Configurações de visualização, refresh rate, tema, etc.</p>
      </div>
    </section>

  </main>

</div>
<script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
<script>
function showTab(tab){
  document.querySelectorAll("main section").forEach(s => s.style.display="none");
  document.getElementById(tab).style.display="block";
}

async function createChart(){
  try{
    const query = document.getElementById("queryInput").value;

    const res = await fetch("/api/query", {
      method:"POST",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify({ query })
    });

    if(!res.ok){
      console.error("Erro na API");
      return;
    }

    const data = await res.json();

    console.log("DATA:", data);

    if(!data.length){
      alert("Sem dados");
      return;
    }

    const card = document.createElement("div");
    card.className = "card";

    const chartId = "chart_" + Date.now();

    card.innerHTML = `
      <h4>${query}</h4>
      <div id="${chartId}" style="height:300px;"></div>
    `;

    document.getElementById("chartsContainer").appendChild(card);

    renderChart(chartId, data);

    // salvar dashboard
    await fetch("/api/dashboard", {
      method:"POST",
      headers:{ "Content-Type":"application/json" },
      body: JSON.stringify({ name: query, query })
    });

  } catch(err){
    console.error("ERRO createChart:", err);
  }
}

function renderChart(id, prometheusData){
  const el = document.getElementById(id);

  if(!el){
    console.error("Elemento não encontrado");
    return;
  }

  const chart = echarts.init(el);

  const series = prometheusData
    .filter(item => item.values && item.values.length)
    .map((item, index) => ({
      name: item.metric?.__name__ || "metric_" + index,
      type: "line",
      smooth: true,
      showSymbol: false,
      data: item.values.map(v => [
        new Date(v[0] * 1000),
        parseFloat(v[1])
      ])
    }));

  if(!series.length){
    console.warn("Sem séries válidas");
    return;
  }

  chart.setOption({
    tooltip: { trigger: "axis" },
    legend: { textStyle: { color: "#fff" } },
    xAxis: { type: "time", axisLabel: { color: "#aaa" } },
    yAxis: { type: "value", axisLabel: { color: "#aaa" } },
    series
  });
}

async function loadDashboards(){
  try{
    const res = await fetch("/api/dashboard");
    const dashboards = await res.json();

    dashboards.forEach(d => {
      document.getElementById("queryInput").value = d.query;
      createChart();
    });

  } catch(err){
    console.error(err);
  }
}

loadDashboards();



</script>

</body>
</html>