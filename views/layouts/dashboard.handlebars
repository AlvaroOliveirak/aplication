<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Temporal Series</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/page-transition.css">
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Zen+Dots&display=swap");

      :root {
        --bg: radial-gradient(circle at 12% 8%, rgba(45, 212, 191, .12), transparent 26%),
              radial-gradient(circle at 88% 0%, rgba(96, 165, 250, .1), transparent 26%),
              linear-gradient(140deg, #08111f 0%, #0c1728 52%, #101827 100%);
        --panel: #101b2b;
        --panel-bg: linear-gradient(180deg, rgba(20, 34, 54, .92), rgba(13, 24, 39, .92));
        --panel-strong: #142236;
        --line: rgba(151, 164, 184, .18);
        --line-strong: rgba(45, 212, 191, .25);
        --muted: #91a0b8;
        --text: #f7fbff;
        --teal: #2dd4bf;
        --green: #22c55e;
        --amber: #f59e0b;
        --red: #ef4444;
        --blue: #60a5fa;
        --shadow: 0 12px 30px rgba(0, 0, 0, .24);

        /* Interactive elements variables */
        --btn-bg: rgba(255, 255, 255, .04);
        --btn-hover-bg: rgba(255, 255, 255, .08);
        --btn-border: transparent;
        --btn-text: #f7fbff;

        --input-bg: rgba(255, 255, 255, .07);
        --input-text: #f7fbff;
        --input-border: rgba(151, 164, 184, .18);

        --option-bg: #101b2b;
        --option-text: #f7fbff;

        --primary-bg: linear-gradient(135deg, #14b8a6, #60a5fa);
        --primary-text: #05101d;
        --primary-hover: linear-gradient(135deg, #2dd4bf, #93c5fd);

        --active-bg: rgba(45, 212, 191, .15);
        --active-border: var(--teal);
        --active-text: #bffaf2;

        --topbar-bg: rgba(7, 16, 29, .68);
        --sidebar-bg: rgba(8, 17, 31, .42);
      }

      body[data-theme="light"] {
        --bg: #e2e8f0;
        --panel: #ffffff;
        --panel-bg: #ffffff;
        --panel-strong: #ffffff;
        --line: #cbd5e1;
        --line-strong: #0d9488;
        --muted: #475569;
        --text: #0f172a;
        --shadow: 0 4px 14px rgba(15, 23, 42, 0.08);

        --btn-bg: #e2e8f0;
        --btn-hover-bg: #cbd5e1;
        --btn-border: #94a3b8;
        --btn-text: #0f172a;

        --input-bg: #ffffff;
        --input-text: #0f172a;
        --input-border: #94a3b8;

        --option-bg: #ffffff;
        --option-text: #0f172a;

        --primary-bg: linear-gradient(135deg, #0d9488, #1d4ed8);
        --primary-text: #ffffff;
        --primary-hover: linear-gradient(135deg, #0f766e, #1e40af);

        --active-bg: #ccfbf1;
        --active-border: #0d9488;
        --active-text: #042f2e;

        --topbar-bg: #ffffff;
        --sidebar-bg: #f8fafc;
      }

      /* High Contrast Light Theme Specific Rules */
      body[data-theme="light"] .panel,
      body[data-theme="light"] .card,
      body[data-theme="light"] .topbar,
      body[data-theme="light"] .overview-item {
        border-color: #cbd5e1;
        background: #ffffff;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
      }

      body[data-theme="light"] .metric-btn {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #0f172a;
      }

      body[data-theme="light"] .metric-btn.active {
        background: #ccfbf1;
        border-color: #0d9488;
        color: #042f2e;
      }

      body[data-theme="light"] .range-btn {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #0f172a;
      }

      body[data-theme="light"] .range-btn.active {
        background: #dbeafe;
        border-color: #2563eb;
        color: #1e40af;
      }

      body[data-theme="light"] .icon-btn {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #0f172a;
      }

      body[data-theme="light"] .icon-btn.danger {
        background: #fee2e2;
        border-color: #fca5a5;
        color: #991b1b;
      }

      body[data-theme="light"] select,
      body[data-theme="light"] input {
        background: #ffffff !important;
        color: #0f172a !important;
        border-color: #94a3b8 !important;
      }

      body[data-theme="light"] select option {
        background: #ffffff !important;
        color: #0f172a !important;
      }

      body[data-theme="light"] label,
      body[data-theme="light"] .threshold-field label,
      body[data-theme="light"] .control-field label {
        color: #1e293b;
      }

      body[data-theme="light"] .threshold-item,
      body[data-theme="light"] .alert-item,
      body[data-theme="light"] .log-item {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #0f172a;
      }

      body[data-theme="light"] .empty-state,
      body[data-theme="light"] .muted {
        color: #475569;
      }

      body[data-theme="light"] h1,
      body[data-theme="light"] h2,
      body[data-theme="light"] h3,
      body[data-theme="light"] h4,
      body[data-theme="light"] strong {
        color: #0f172a;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        transition: background-color .3s ease, color .3s ease;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 20px;
        background: var(--topbar-bg);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(8px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        color: var(--text);
        text-decoration: none;
      }

      .brand-mark {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: linear-gradient(135deg, var(--teal), var(--blue));
        color: #06111f;
        font-weight: 800;
        font-size: 13px;
      }

      .logo {
        font-family: "Zen Dots", Inter, sans-serif;
        font-size: 16px;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .subtitle {
        margin-top: 1px;
        color: var(--muted);
        font-size: 11px;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav a,
      .nav button,
      .ghost-btn,
      .primary-btn,
      .icon-btn,
      .range-btn,
      .metric-btn {
        min-height: 32px;
        border-radius: 6px;
        color: var(--text);
        cursor: pointer;
        font-size: 12px;
        text-decoration: none;
        transition: background .18s ease, border-color .18s ease, color .18s ease, transform .18s ease;
      }

      .nav a,
      .nav button,
      .ghost-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0 10px;
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        color: var(--btn-text);
      }

      .nav a:hover,
      .nav button:hover,
      .ghost-btn:hover {
        background: var(--btn-hover-bg);
        border-color: var(--line);
        color: var(--btn-text);
      }

      .nav .active {
        background: var(--active-bg);
        border-color: var(--active-border);
        color: var(--active-text);
      }

      .dashboard {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        min-height: calc(100vh - 56px);
      }

      .main {
        min-width: 0;
        padding: 16px 20px;
        overflow: auto;
        width: 100%;
      }

      /* Horizontal Top Status Bar for Thresholds and Alerts */
      .top-status-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
      }

      .top-status-bar .panel {
        margin-bottom: 0;
        padding: 10px 14px;
      }

      .top-status-bar h3 {
        font-size: 12px;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--teal);
        display: flex;
        align-items: center;
        gap: 6px;
      }

      #thresholdList,
      #alertFeed {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-height: 140px;
        overflow-y: auto;
      }

      .overview {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
      }

      .overview-item {
        min-height: 64px;
        padding: 8px 12px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: var(--overview-bg, rgba(255, 255, 255, .045));
      }

      .overview-item span {
        color: var(--muted);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
      }

      .overview-item strong {
        display: block;
        margin-top: 2px;
        font-size: 20px;
      }

      .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
      }

      .eyebrow {
        margin: 0 0 2px;
        color: var(--teal);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      h4,
      p {
        margin-top: 0;
      }

      h1 {
        margin-bottom: 0;
        font-size: 22px;
        letter-spacing: 0;
      }

      h3 {
        margin-bottom: 8px;
        font-size: 13px;
      }

      h4 {
        margin: 0;
        font-size: 13px;
      }

      .muted {
        color: var(--muted);
      }

      .panel,
      .card {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel-bg);
        box-shadow: var(--shadow);
      }

      .panel {
        padding: 12px 14px;
        margin-bottom: 14px;
      }

      .card {
        padding: 12px 14px;
        overflow: hidden;
      }

      /* Compact Grid for Dashboards */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 14px;
      }

      .builder {
        margin-bottom: 14px;
      }

      .builder-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0 14px;
        background: var(--primary-bg);
        color: var(--primary-text);
        font-weight: 800;
        border: none;
      }

      .primary-btn:hover,
      .icon-btn:hover,
      .range-btn:hover,
      .metric-btn:hover {
        transform: translateY(-1px);
      }

      #metricMenu {
        display: none;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid var(--line);
        opacity: 0;
        transform: translateY(-6px);
        transition: .2s ease;
      }

      #metricMenu.show {
        opacity: 1;
        transform: translateY(0);
      }

      #metricOptions {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 8px;
        margin-bottom: 10px;
      }

      .metric-btn,
      .range-btn {
        background: rgba(255, 255, 255, .05);
        border: 1px solid var(--line);
      }

      .metric-btn {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 9px;
        color: #dce7f7;
        font-size: 11px;
        font-weight: 700;
        text-align: left;
      }

      .metric-btn.active {
        background: rgba(45, 212, 191, .13);
        border-color: rgba(45, 212, 191, .48);
        color: #d9fffb;
      }

      .range-buttons {
        display: flex;
        gap: 5px;
        margin: 8px 0 6px;
        flex-wrap: wrap;
      }

      .range-btn {
        min-height: 24px;
        padding: 0 7px;
        color: #cdd8ea;
        font-size: 10px;
        font-weight: 800;
        border-radius: 5px;
      }

      .range-btn.active {
        background: rgba(96, 165, 250, .16);
        border-color: rgba(96, 165, 250, .5);
        color: #eaf4ff;
      }

      .chart-header,
      .item-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
      }

      .card-actions {
        display: flex;
        gap: 5px;
        flex-shrink: 0;
      }

      .icon-btn {
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        background: rgba(255, 255, 255, .06);
        border: 1px solid var(--line);
        color: #e9f2ff;
        font-size: 11px;
        font-weight: 800;
        border-radius: 6px;
      }

      .icon-btn.danger {
        background: rgba(239, 68, 68, .12);
        border-color: rgba(239, 68, 68, .34);
        color: #fecaca;
      }

      /* Slightly Increased Chart Box Height */
      .chart-box {
        height: 260px;
        min-width: 0;
      }

      .alert-inline {
        display: none;
        gap: 8px;
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid var(--line);
      }

      .threshold-form {
        display: grid;
        gap: 8px;
      }

      .threshold-form legend {
        color: var(--muted);
        font-size: 11px;
        line-height: 1.4;
      }

      .threshold-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .threshold-field label {
        display: block;
        margin-bottom: 4px;
        color: #dce7f8;
        font-size: 11px;
        font-weight: 700;
      }

      .threshold-field label.warning-label {
        color: #fcd34d;
      }

      .threshold-field label.critical-label {
        color: #fca5a5;
      }

      .thresholdInput {
        width: 100%;
        min-height: 28px;
        padding: 0 8px;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, .07);
        color: var(--text);
        font-size: 11px;
        outline: none;
      }

      .thresholdInput:focus {
        border-color: rgba(45, 212, 191, .62);
      }

      .control-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(115px, 1fr));
        gap: 6px;
        margin-top: 8px;
      }

      .control-field {
        display: grid;
        gap: 3px;
      }

      .control-field label {
        color: var(--text);
        opacity: 0.85;
        font-size: 10px;
        font-weight: 800;
      }

      .control-field input,
      .control-field select,
      .custom-query {
        width: 100%;
        min-height: 28px;
        padding: 0 6px;
        border-radius: 6px;
        border: 1px solid var(--input-border);
        background: var(--input-bg);
        color: var(--input-text);
        font-size: 11px;
        outline: none;
      }

      .control-field select option {
        background: var(--option-bg);
        color: var(--option-text);
      }

      .custom-query {
        margin-top: 8px;
        font-family: Consolas, monospace;
      }

      .stat-card {
        display: grid;
        align-content: center;
        min-height: 200px;
        padding: 14px;
        text-align: center;
      }

      .stat-value {
        font-size: clamp(32px, 5vw, 54px);
        line-height: 1;
        font-weight: 800;
      }

      .stat-label {
        margin-top: 8px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
      }

      /* Horizontal & Compact Threshold and Alert Items */
      .threshold-item,
      .alert-live,
      .log {
        flex: 1 1 200px;
        min-width: 180px;
        padding: 6px 10px;
        margin-bottom: 0;
        border-radius: 6px;
        background: rgba(255, 255, 255, .055);
        border: 1px solid var(--line);
        border-left-width: 3px;
        font-size: 11px;
        transition: border-color .2s ease, background .2s ease;
      }

      .threshold-item.status-OK {
        border-left-color: #22c55e;
        background: rgba(34, 197, 94, .08);
      }

      .threshold-item.status-WARNING {
        border-left-color: #f59e0b;
        background: rgba(245, 158, 11, .1);
      }

      .threshold-item.status-CRITICAL {
        border-left-color: #ef4444;
        background: rgba(239, 68, 68, .12);
      }

      .delete-threshold-btn {
        width: 22px;
        height: 22px;
        border-radius: 5px;
        background: rgba(239, 68, 68, .12);
        color: #fecaca;
        font-size: 10px;
        cursor: pointer;
        border: none;
      }

      .alert-live {
        animation: pulse 1.8s infinite;
      }

      .alert-ok {
        border-color: rgba(34, 197, 94, .36);
      }

      .alert-warning {
        border-color: rgba(245, 158, 11, .46);
        background: rgba(245, 158, 11, .11);
      }

      .alert-critical {
        border-color: rgba(239, 68, 68, .5);
        background: rgba(239, 68, 68, .12);
      }

      .logs {
        display: grid;
        gap: 8px;
        max-height: none;
        overflow: visible;
      }

      .log {
        display: grid;
        grid-template-columns: 90px minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
        margin: 0;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 20px;
        padding: 0 7px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
      }

      .status-OK {
        background: rgba(34, 197, 94, .12);
        color: #bbf7d0;
      }

      .status-WARNING {
        background: rgba(245, 158, 11, .14);
        color: #fde68a;
      }

      .status-CRITICAL {
        background: rgba(239, 68, 68, .15);
        color: #fecaca;
      }

      .empty-state {
        display: grid;
        place-items: center;
        min-height: 80px;
        width: 100%;
        border: 1px dashed var(--line);
        border-radius: 6px;
        color: var(--muted);
        font-size: 11px;
        text-align: center;
        padding: 10px;
      }

      @keyframes pulse {
        0%, 100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.012);
        }
      }

      @media (max-width: 880px) {
        .topbar,
        .section-head,
        .builder-bar {
          align-items: stretch;
          flex-direction: column;
        }

        .nav {
          justify-content: flex-start;
        }

        .main {
          padding: 12px;
        }

        .grid {
          grid-template-columns: 1fr;
        }

        .overview {
          grid-template-columns: 1fr;
        }

        .log {
          grid-template-columns: 1fr;
        }

        .top-status-bar {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body data-theme="{{theme}}">
    <header class="topbar">
      <a class="brand" href="/">
        <div class="brand-mark">TS</div>
        <div>
          <div class="logo">Prom_TS</div>
          <div class="subtitle">Monitoramento Prometheus em tempo real</div>
        </div>
      </a>

      <nav class="nav" aria-label="Navegacao principal">
        <a href="/">Inicio</a>
        <button class="active" data-tab-button="dashboards" onclick="showTab('dashboards')">Dashboard</button>
        <button data-tab-button="logs" onclick="showTab('logs')">Logs</button>
        <button data-tab-button="settings" onclick="showTab('settings')">Config</button>
        {{#if user}}
          <a href="/logout">Sair</a>
        {{/if}}
      </nav>
    </header>

    <div class="dashboard">
      <main class="main">
        <section id="dashboards">
          <!-- Horizontal Top Status Bar for Thresholds and Alerts -->
          <div class="top-status-bar">
            <div class="panel">
              <h3>Thresholds Ativos</h3>
              <div id="thresholdList"></div>
            </div>

            <div class="panel">
              <h3>Alertas em Aberto</h3>
              <div id="alertFeed"></div>
            </div>
          </div>

          <div class="section-head">
            <div>
              <p class="eyebrow">Metricas</p>
              <h1>Dashboards</h1>
            </div>
            <div class="muted" id="refreshStatus" style="font-size: 11px;">Atualizacao automatica ativa.</div>
          </div>

          <div class="overview" aria-label="Resumo dos dashboards">
            <div class="overview-item">
              <span>Dashboards</span>
              <strong id="dashboardCount">0</strong>
            </div>
            <div class="overview-item">
              <span>Alertas ativos</span>
              <strong id="activeAlertCount">0</strong>
            </div>
            <div class="overview-item">
              <span>Refresh</span>
              <strong id="refreshSummary">5s</strong>
            </div>
          </div>

          <!-- Painel de Máquinas e Token -->
          <div class="panel" style="margin-bottom: 18px;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
              <div>
                <h3 style="margin: 0; font-size: 16px;">Computador Ativo</h3>
                <div class="muted" style="font-size: 11px; margin-top: 2px;">Selecione o computador de onde deseja visualizar as métricas.</div>
              </div>
              <div style="display: flex; gap: 12px; align-items: center;">
                <select id="machineSelect" onchange="selectMachine(this.value)" style="min-height: 36px; padding: 0 12px; background: var(--btn-bg); border: 1px solid var(--line); border-radius: 6px; color: var(--text); font-size: 13px; font-weight: 500; outline: none; cursor: pointer;">
                  <option value="">Carregando computadores...</option>
                </select>
                <button class="primary-btn" onclick="toggleTokenPanel()" style="min-height: 36px; padding: 0 14px; font-size: 12px;">Token do Agente</button>
              </div>
            </div>
            
            <div id="tokenPanel" style="display: none; margin-top: 16px; padding: 16px; background: rgba(96, 165, 250, 0.06); border: 1px dashed rgba(96, 165, 250, 0.3); border-radius: 8px;">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div>
                  <span style="font-weight: 600; font-size: 13px;">Seu Token de Registro:</span>
                  <code id="agentTokenCode" style="margin-left: 8px; background: rgba(0,0,0,0.3); padding: 5px 10px; border-radius: 4px; font-family: monospace; font-size: 13px; color: var(--blue);">promts_...</code>
                </div>
                <div style="display: flex; gap: 8px;">
                  <a href="/api/machine/agent/download" class="primary-btn" style="display: flex; align-items: center; justify-content: center; min-height: 28px; padding: 0 12px; font-size: 11px; text-decoration: none; font-weight: 600; color: var(--primary-text); background: var(--primary-bg);">Baixar Agente (.zip)</a>
                  <button class="ghost-btn" onclick="copyAgentToken()" style="min-height: 28px; padding: 0 10px; font-size: 11px;">Copiar Token</button>
                  <button class="ghost-btn" onclick="generateNewToken()" style="min-height: 28px; padding: 0 10px; font-size: 11px; border-color: rgba(239, 68, 68, 0.4); color: #fca5a5;">Regerar</button>
                </div>
              </div>
              <div class="muted" style="font-size: 11px; margin-top: 10px; line-height: 1.4;">
                <strong>Como usar:</strong> Configure o seu agente local utilizando este token. O agente coletará CPU, RAM, Disco e Rede e os enviará diretamente para esta plataforma.
              </div>
            </div>
          </div>

          <div class="builder panel">
            <div class="builder-bar">
              <div>
                <h3>Selecionar dashboards</h3>
                <div class="muted" style="font-size: 11px;">Escolha as métricas que você quer acompanhar.</div>
              </div>
              <button class="primary-btn" onclick="toggleMetricMenu()">Selecionar</button>
            </div>

            <div id="metricMenu">
              <div id="metricOptions"></div>
              <input id="customQueryInput" class="custom-query" type="text" placeholder="Cole uma query Prometheus personalizada">
              <button class="primary-btn" style="margin-top: 8px;" onclick="createSelectedCharts()">Criar dashboards</button>
            </div>
          </div>

          <div class="grid" id="chartsContainer"></div>

          <div class="panel" style="margin-top: 18px;">
            <h3>Análise de Tendências</h3>
            <div class="muted" style="margin-bottom: 12px; font-size: 11px;">Insights baseados no comportamento recente das métricas.</div>
            <div class="grid" id="trendContainer" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));">
              <div class="empty-state">Carregando análise de tendências...</div>
            </div>
          </div>
        </section>

        <section id="logs" style="display:none;">
          <div class="section-head">
            <div>
              <p class="eyebrow">Historico</p>
              <h1>Logs de alertas</h1>
            </div>
            <button class="ghost-btn" onclick="loadAlertLogs()">Atualizar logs</button>
          </div>

          <div class="panel">
            <div class="logs" id="logContainer"></div>
          </div>
        </section>

        <section id="settings" style="display:none;">
          <div class="section-head">
            <div>
              <p class="eyebrow">Preferencias</p>
              <h1>Configuracoes</h1>
            </div>
          </div>

          <div class="panel">
            <h3>Visualizacao</h3>
            <p class="muted" style="font-size: 11px;">Os graficos usam janelas independentes por card, refresh automatico, anomalias por z-score e media movel.</p>
            <div class="control-grid">
              <div class="control-field">
                <label for="refreshIntervalInput">Atualizar dashboards a cada</label>
                <select id="refreshIntervalInput" onchange="updateRefreshInterval()">
                  <option value="3000">3 segundos</option>
                  <option value="5000">5 segundos</option>
                  <option value="10000">10 segundos</option>
                  <option value="30000">30 segundos</option>
                  <option value="60000">1 minuto</option>
                </select>
              </div>
              <div class="control-field">
                <label>Tema</label>
                <button class="ghost-btn" onclick="toggleTheme()">Alternar tema claro/escuro</button>
              </div>
              <div class="control-field">
                <label>Email de alertas</label>
                <button class="ghost-btn" onclick="sendTestEmail()">Enviar email de teste</button>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
    <script>
      const currentUserEmail = "{{user.email}}";

      const systemQueries = {
        cpu: '100 - (avg by(instance)(rate(windows_cpu_time_total{mode="idle"}[1m])) * 100)',
        ram: '100 - (100 * windows_memory_physical_free_bytes / windows_memory_physical_total_bytes)',
        disco: '100 * (1 - (windows_logical_disk_free_bytes{volume!~"HarddiskVolume.+"} / windows_logical_disk_size_bytes{volume!~"HarddiskVolume.+"}))',
        redeRx: 'irate(windows_net_bytes_received_total[5s])',
        redeTx: 'irate(windows_net_bytes_sent_total[15s])',
        load1m: 'windows_system_processor_queue_length',
        load5m: 'avg_over_time(windows_system_processor_queue_length[5m])'
      };

      let metricList = [
        {
          id: "ram",
          name: "RAM (%)",
          unit: "%",
          query: systemQueries.ram
        },
        {
          id: "cpu",
          name: "CPU (%)",
          unit: "%",
          query: systemQueries.cpu
        },
        {
          id: "disco",
          name: "Disco (%)",
          unit: "%",
          query: systemQueries.disco
        },
        {
          id: "rede_rx",
          name: "Rede RX (B/s)",
          unit: "B/s",
          query: systemQueries.redeRx
        },
        {
          id: "rede_tx",
          name: "Rede TX (B/s)",
          unit: "B/s",
          query: systemQueries.redeTx
        },
        {
          id: "load_1m",
          name: "Fila Processador (Inst.)",
          unit: "threads",
          query: systemQueries.load1m
        },
        {
          id: "load_5m",
          name: "Fila Processador (Média 5m)",
          unit: "threads",
          query: systemQueries.load5m
        }
      ];

      let selectedMetrics = new Set();
      const activeDashboards = new Set();
      const socket = io();

      socket.on("alert:created", () => {
        loadThresholds();
        loadAlertFeed();
        loadAlertLogs();
      });

      function resolveThresholds(alert) {
        const criticalThreshold = Number(alert?.criticalThreshold ?? alert?.threshold);
        const warningThreshold = Number(
          alert?.warningThreshold ?? (Number.isFinite(criticalThreshold) ? criticalThreshold * 0.8 : NaN)
        );

        return { warningThreshold, criticalThreshold };
      }

      function statusColor(status) {
        if (status === "CRITICAL") {
          return "#fca5a5";
        }
        if (status === "WARNING") {
          return "#fcd34d";
        }
        return "#86efac";
      }

      function getMetricUnit(query, fallback = "") {
        const metric = metricList.find(m => m.query === query);
        if (metric?.unit) return metric.unit;
        const q = (query || "").toLowerCase();
        if (q.includes("cpu") || q.includes("memory") || q.includes("disco") || q.includes("ram") || q.includes("logical_disk")) return "%";
        if (q.includes("bytes_received") || q.includes("bytes_sent") || q.includes("network_receive") || q.includes("network_transmit")) return "B/s";
        if (q.includes("processor_queue")) return "threads";
        return fallback;
      }

      function formatValueWithUnit(value, unit, seriesName = "", query = "") {
        const val = Number(value);
        if (!Number.isFinite(val)) return "-";
        
        const resolvedUnit = unit || getMetricUnit(query);

        if (resolvedUnit === "%") {
          return `${val.toFixed(1)}%`;
        }
        if (resolvedUnit === "B/s" || (query && (query.includes("net") || query.includes("network")))) {
          if (val >= 1024 * 1024 * 1024) return `${(val / (1024 * 1024 * 1024)).toFixed(2)} GB/s`;
          if (val >= 1024 * 1024) return `${(val / (1024 * 1024)).toFixed(2)} MB/s`;
          if (val >= 1024) return `${(val / 1024).toFixed(2)} KB/s`;
          return `${val.toFixed(0)} B/s`;
        }
        if (resolvedUnit === "threads") {
          return `${val.toFixed(1)} threads`;
        }
        return resolvedUnit ? `${val.toFixed(2)} ${resolvedUnit}` : val.toFixed(2);
      }

      function formatShortBytesRate(val) {
        const n = Number(val);
        if (!Number.isFinite(n) || n === 0) return "0";
        if (n >= 1024 * 1024 * 1024) return `${(n / (1024 * 1024 * 1024)).toFixed(1)} GB/s`;
        if (n >= 1024 * 1024) return `${(n / (1024 * 1024)).toFixed(1)} MB/s`;
        if (n >= 1024) return `${(n / 1024).toFixed(1)} KB/s`;
        return `${n.toFixed(0)} B/s`;
      }

      function buildThresholdMarkLines(thresholdData) {
        if (!thresholdData) {
          return undefined;
        }

        const { warningThreshold, criticalThreshold } = resolveThresholds(thresholdData);
        const unit = thresholdData.unit || getMetricUnit(thresholdData.query, "%");

        return {
          silent: true,
          symbol: ["none", "none"],
          data: [
            {
              yAxis: warningThreshold,
              lineStyle: {
                color: "#f59e0b",
                width: 1.5,
                type: "dashed"
              },
              label: {
                show: true,
                position: "end",
                formatter: `Atenção ${warningThreshold}${unit}`,
                color: "#fff",
                fontSize: 10,
                fontWeight: "bold",
                backgroundColor: "rgba(245,158,11,.9)",
                padding: [2, 5],
                borderRadius: 4
              }
            },
            {
              yAxis: criticalThreshold,
              lineStyle: {
                color: "#ef4444",
                width: 1.5,
                type: "dashed"
              },
              label: {
                show: true,
                position: "end",
                formatter: `Alerta ${criticalThreshold}${unit}`,
                color: "#fff",
                fontSize: 10,
                fontWeight: "bold",
                backgroundColor: "rgba(239,68,68,.9)",
                padding: [2, 5],
                borderRadius: 4
              }
            }
          ]
        };
      }

      function getMetricDefinitionByQuery(query) {
        return metricList.find(metric => metric.query === query);
      }

      function resolveMetricId(query, metricId) {
        if (metricId && metricId !== "undefined" && metricId !== "null") {
          return metricId;
        }

        return getMetricDefinitionByQuery(query)?.id || query;
      }

      function emptyState(message) {
        return `<div class="empty-state">${message}</div>`;
      }

      function formatNumber(value) {
        const number = Number(value);
        return Number.isFinite(number) ? number.toFixed(2) : "-";
      }

      function formatInterval(ms) {
        const seconds = Math.round(Number(ms) / 1000);
        return seconds >= 60 ? `${Math.round(seconds / 60)}min` : `${seconds}s`;
      }

      async function removeDashboardByQuery(query) {
        document.querySelectorAll(".card[data-query]").forEach(card => {
          if (card.dataset.query === query) {
            const chart = echarts.getInstanceByDom(card.querySelector("[data-chart-id]"));
            chart?.dispose();
            card.remove();
          }
        });

        activeDashboards.delete(query);
      }

      function toggleMetricMenu() {
        const menu = document.getElementById("metricMenu");

        if (menu.style.display === "none" || !menu.style.display) {
          menu.style.display = "block";
          requestAnimationFrame(() => menu.classList.add("show"));
        } else {
          menu.classList.remove("show");
          setTimeout(() => {
            menu.style.display = "none";
          }, 240);
        }

        renderMetricOptions();
      }

      function renderMetricOptions() {
        const container = document.getElementById("metricOptions");
        container.innerHTML = "";

        metricList.forEach(metric => {
          const btn = document.createElement("button");
          const isActive = selectedMetrics.has(metric.query) || activeDashboards.has(metric.query);
          btn.className = `metric-btn${isActive ? " active" : ""}`;
          btn.innerHTML = `<span>${metric.name}</span><span>${isActive ? "Ativo" : "Adicionar"}</span>`;

          btn.onclick = async () => {
            if (activeDashboards.has(metric.query)) {
              await removeDashboardByQuery(metric.query);
            } else if (selectedMetrics.has(metric.query)) {
              selectedMetrics.delete(metric.query);
            } else {
              selectedMetrics.add(metric.query);
            }

            renderMetricOptions();
          };

          container.appendChild(btn);
        });
      }

      async function createSelectedCharts() {
        const customInput = document.getElementById("customQueryInput")?.value.trim();

        if (customInput) {
          let queryToUse = customInput;
          let nameToUse = customInput;

          const nameToQueryMap = {
            "uso de cpu": systemQueries.cpu,
            "cpu": systemQueries.cpu,
            "memoria": systemQueries.ram,
            "memória": systemQueries.ram,
            "ram": systemQueries.ram,
            "disco": systemQueries.disco,
            "rede": systemQueries.redeRx
          };

          const lowerInput = customInput.toLowerCase();
          if (nameToQueryMap[lowerInput]) {
            queryToUse = nameToQueryMap[lowerInput];
            nameToUse = customInput;
          }

          const inferredResponse = await fetch("/api/metrics/infer", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({ query: queryToUse })
          });
          const inferred = await inferredResponse.json();
          
          metricList = metricList.filter(metric => metric.query !== queryToUse);
          metricList.push({
            id: inferred.id || queryToUse,
            name: nameToUse || inferred.name || resolveMetricName(queryToUse, []),
            query: queryToUse,
            unit: inferred.unit || ""
          });
          selectedMetrics.add(queryToUse);
          document.getElementById("customQueryInput").value = "";
        }

        if (selectedMetrics.size === 0) {
          return;
        }

        for (const query of selectedMetrics) {
          if (activeDashboards.has(query)) {
            continue;
          }

          const metric = metricList.find(m => m.query === query);
          const response = await fetch("/api/dashboard", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              query,
              metricId: metric?.id || query,
              chartType: "line",
              aggregation: "none"
            })
          });

          const dashboard = await response.json();
          await renderSavedChart(dashboard);
          activeDashboards.add(query);
        }

        selectedMetrics.clear();
        renderMetricOptions();
      }

      function showTab(tab) {
        document.querySelectorAll("main section").forEach(s => s.style.display = "none");
        document.getElementById(tab).style.display = "block";

        document.querySelectorAll("[data-tab-button]").forEach(button => {
          button.classList.toggle("active", button.dataset.tabButton === tab);
        });

        if (tab === "logs") {
          loadAlertLogs();
        }
      }

      async function deleteDashboard(id, btn) {
        const card = btn.closest(".card");
        const query = card.dataset.query;

        await fetch(`/api/dashboard/${id}`, {
          method: "DELETE"
        });

        const chart = echarts.getInstanceByDom(card.querySelector("[data-chart-id]"));
        chart?.dispose();
        card.remove();
        activeDashboards.delete(query);

        // Remove imediatamente os thresholds e alertas associados da UI
        document.querySelectorAll(`#thresholdList .threshold-item[data-query="${CSS.escape(query)}"]`).forEach(el => el.remove());
        document.querySelectorAll(`#alertFeed .alert-item[data-query="${CSS.escape(query)}"]`).forEach(el => el.remove());

        // Limpa o contêiner de tendências caso estivesse exibindo a análise deste card
        const trendContainer = document.getElementById("trendContainer");
        if (trendContainer) {
          const trendTitle = trendContainer.querySelector("h4")?.textContent || "";
          const cardTitle = card.querySelector("h4")?.textContent || "";
          if (trendTitle && cardTitle && trendTitle.includes(cardTitle)) {
            trendContainer.innerHTML = emptyState("Selecione a análise de tendência em um card ativo.");
          }
        }

        document.getElementById("dashboardCount").textContent = String(document.querySelectorAll(".card[data-query]").length);

        await loadThresholds();
        await loadAlertFeed();
        await loadAlertLogs();
        renderMetricOptions();
      }

      function beautifyMetric(name) {
        return name
          .replace(/node_/g, "")
          .replace(/windows_/g, "")
          .replace(/_seconds_total/g, "")
          .replace(/_/g, " ")
          .replace(/\b\w/g, l => l.toUpperCase());
      }

      function resolveMetricName(query, data) {
        const q = (query || "").toLowerCase();

        if ((q.includes("node_cpu_seconds_total") || q.includes("windows_cpu_time_total")) && q.includes("rate") && q.includes("idle")) {
          return "Uso de CPU (%)";
        }

        if ((q.includes("node_memory_memavailable_bytes") && q.includes("node_memory_memtotal_bytes")) || q.includes("windows_memory_physical")) {
          return "Uso de Memória (%)";
        }

        if ((q.includes("node_filesystem_size_bytes") && q.includes("node_filesystem_avail_bytes")) || q.includes("windows_logical_disk")) {
          return "Uso de Disco (%)";
        }

        if (q.includes("node_network_receive_bytes_total") || q.includes("windows_net_bytes_received_total")) {
          return "Entrada de Rede RX (B/s)";
        }

        if (q.includes("node_network_transmit_bytes_total") || q.includes("windows_net_bytes_sent_total")) {
          return "Saída de Rede TX (B/s)";
        }

        if (q.includes("avg_over_time") && q.includes("windows_system_processor_queue")) {
          return "Fila do Processador (Média 5m)";
        }

        if (q.includes("node_load1") || q.includes("windows_system_processor_queue_length") || q.includes("windows_system_processor_queue")) {
          return "Fila do Processador (Inst.)";
        }

        if (data[0]?.metric?.__name__) {
          return beautifyMetric(data[0].metric.__name__);
        }

        return beautifyMetric(query);
      }

      async function renderSavedChart(dashboard) {
        try {
          const res = await fetch("/api/query", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              query: dashboard.query,
              machineId: window.selectedMachineId
            })
          });

          const { id, query } = dashboard;
          const payload = await res.json();
          const data = normalizeQueryPayload(payload);

          if (!Array.isArray(data.series)) {
            console.warn("Formato invalido:", payload);
            return;
          }

          const card = document.createElement("div");
          const container = document.getElementById("chartsContainer");
          const chartId = `chart_${Date.now()}_${Math.random().toString(36).slice(2)}`;
          const metricName = resolveMetricName(dashboard.query, data.series);
          const metricId = resolveMetricId(dashboard.query, dashboard.metricId);

          card.className = "card";
          card.dataset.query = dashboard.query;
          card.dataset.metricId = metricId;
          card.dataset.chartId = chartId;
          card.dataset.range = "300";
          card.dataset.chartType = dashboard.chartType || "line";
          card.dataset.aggregation = dashboard.aggregation || "none";
          card.dataset.showTrend = "true";
          card.innerHTML = `
            <div class="chart-header">
              <div>
                <h4>${metricName}</h4>
                <div class="muted chart-window" style="font-size:11px; margin-top:2px;">Janela movel de dados</div>
              </div>
              <div class="card-actions">
                <button class="icon-btn" title="Mostrar/ocultar analise de tendencia" onclick="toggleTrendAnalysis(this)" style="background: rgba(96, 165, 250, 0.12); border-color: rgba(96, 165, 250, 0.34); color: #bfdbfe;">T</button>
                <button class="icon-btn" title="Configurar threshold" onclick="toggleAlertBox(this)">!</button>
                <button class="icon-btn danger" title="Remover dashboard" onclick="deleteDashboard(${id}, this)">X</button>
              </div>
            </div>
            <div class="control-grid">
              <div class="control-field">
                <label>Grafico</label>
                <select onchange="updateCardMode(this)">
                  <option value="line" ${card.dataset.chartType === "line" ? "selected" : ""}>Linha</option>
                  <option value="bar" ${card.dataset.chartType === "bar" ? "selected" : ""}>Barras</option>
                  <option value="area" ${card.dataset.chartType === "area" ? "selected" : ""}>Area</option>
                  <option value="scatter" ${card.dataset.chartType === "scatter" ? "selected" : ""}>Pontos</option>
                  <option value="gauge" ${card.dataset.chartType === "gauge" ? "selected" : ""}>Medidor</option>
                  <option value="pie" ${card.dataset.chartType === "pie" ? "selected" : ""}>Pizza</option>
                  <option value="stat" ${card.dataset.chartType === "stat" ? "selected" : ""}>Indicador</option>
                </select>
              </div>
              <div class="control-field">
                <label>Agregacao</label>
                <select onchange="updateCardMode(this)">
                  <option value="none" ${card.dataset.aggregation === "none" ? "selected" : ""}>Sem agregacao</option>
                  <option value="avg" ${card.dataset.aggregation === "avg" ? "selected" : ""}>Media</option>
                  <option value="sum" ${card.dataset.aggregation === "sum" ? "selected" : ""}>Soma</option>
                  <option value="min" ${card.dataset.aggregation === "min" ? "selected" : ""}>Minimo</option>
                  <option value="max" ${card.dataset.aggregation === "max" ? "selected" : ""}>Maximo</option>
                  <option value="mode" ${card.dataset.aggregation === "mode" ? "selected" : ""}>Moda</option>
                </select>
              </div>
              <div class="control-field">
                <label>Inicio</label>
                <input class="card-start-input" type="datetime-local" onchange="refreshCard(this.closest('.card'))">
              </div>
              <div class="control-field">
                <label>Fim</label>
                <input class="card-end-input" type="datetime-local" onchange="refreshCard(this.closest('.card'))">
              </div>
            </div>
            <div class="range-buttons">
              <button class="range-btn active" data-range="300" onclick="changeRange(this, 300)">5m</button>
              <button class="range-btn" data-range="3600" onclick="changeRange(this, 3600)">1h</button>
              <button class="range-btn" data-range="10800" onclick="changeRange(this, 10800)">3h</button>
              <button class="range-btn" data-range="43200" onclick="changeRange(this, 43200)">12h</button>
              <button class="range-btn" data-range="86400" onclick="changeRange(this, 86400)">24h</button>
            </div>
            <div id="${chartId}" data-chart-id="${chartId}" class="chart-box"></div>
            <div class="alert-inline">
              <form class="threshold-form">
                <legend>Zona verde abaixo do limite de atenção. Entre atenção e alerta: WARNING. Acima: CRITICAL.</legend>
                <div class="threshold-fields">
                  <div class="threshold-field">
                    <label class="warning-label" for="warning_${chartId}">Limite de atenção</label>
                    <input id="warning_${chartId}" class="thresholdInput warningInput" type="number" step="0.01" placeholder="Ex: 60" required>
                  </div>
                  <div class="threshold-field">
                    <label class="critical-label" for="critical_${chartId}">Limite de alerta</label>
                    <input id="critical_${chartId}" class="thresholdInput criticalInput" type="number" step="0.01" placeholder="Ex: 80" required>
                  </div>
                  <div class="threshold-field" style="grid-column: span 2;">
                    <label for="emails_${chartId}" style="color: var(--teal);">E-mails para notificação (separados por vírgula)</label>
                    <input id="emails_${chartId}" class="thresholdInput emailsInput" type="text" value="${currentUserEmail}" placeholder="ex: dev@empresa.com, admin@empresa.com">
                  </div>
                </div>
                <button class="primary-btn save-threshold-btn" type="button" style="min-height: 28px; font-size: 11px;">Salvar limites e e-mails</button>
              </form>
            </div>
          `;

          container.querySelector(".empty-state")?.remove();
          container.appendChild(card);
          document.getElementById("dashboardCount").textContent = String(document.querySelectorAll(".card[data-query]").length);
          card.querySelector(".save-threshold-btn").addEventListener("click", event => {
            createInlineAlert(dashboard.query, event.currentTarget);
          });
          activeDashboards.add(dashboard.query);

          const thresholdData = await getThresholdByQuery(dashboard.query);

          if (thresholdData) {
            const { warningThreshold, criticalThreshold } = resolveThresholds(thresholdData);
            card.querySelector(".warningInput").value = warningThreshold;
            card.querySelector(".criticalInput").value = criticalThreshold;
            card.querySelector(".emailsInput").value = thresholdData.notificationEmails || currentUserEmail;
          } else {
            card.querySelector(".emailsInput").value = currentUserEmail;
          }

          renderChart(chartId, data, dashboard.query, 300, thresholdData);
        } catch (err) {
          console.error("Erro renderSavedChart:", err);
        }
      }

      function toggleAlertBox(btn) {
        const box = btn.closest(".card").querySelector(".alert-inline");
        box.style.display = box.style.display === "grid" ? "none" : "grid";
      }

      async function createInlineAlert(query, btn) {
        const card = btn.closest(".card");
        const warningThreshold = Number(card.querySelector(".warningInput")?.value);
        const criticalThreshold = Number(card.querySelector(".criticalInput")?.value);
        const notificationEmails = card.querySelector(".emailsInput")?.value?.trim() || currentUserEmail;

        if (!Number.isFinite(warningThreshold) || !Number.isFinite(criticalThreshold)) {
          alert("Defina os limites de atencao e alerta");
          return;
        }

        if (warningThreshold >= criticalThreshold) {
          alert("O limite de atencao deve ser menor que o limite de alerta");
          return;
        }

        const response = await fetch("/api/alert", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            metricId: resolveMetricId(query, card.dataset.metricId),
            query,
            warningThreshold,
            criticalThreshold,
            notificationEmails,
            metricName: card.querySelector("h4").innerText,
            unit: getMetricUnit(query, "%")
          })
        });

        if (!response.ok) {
          const error = await response.json().catch(() => ({}));
          alert(error.error || "Nao foi possivel salvar os limites");
          return;
        }

        card.querySelector(".alert-inline").style.display = "none";
        await loadThresholds();
        await loadAlertFeed();
        await refreshCharts();
      }

      function normalizeQueryPayload(payload, fallbackRange = 300) {
        if (Array.isArray(payload)) {
          const end = Math.floor(Date.now() / 1000);
          return {
            series: payload,
            start: end - fallbackRange,
            end
          };
        }

        return {
          series: payload.series || [],
          comparisonSeries: payload.comparisonSeries || [],
          start: payload.start,
          end: payload.end
        };
      }

      function aggregateValues(values, mode, chartType) {
        if (!values || !values.length) return [];
        
        if ((!mode || mode === "none") && ["line", "area", "bar", "scatter"].includes(chartType)) {
          return values;
        }

        const nums = values.map(point => Number(point[1])).filter(Number.isFinite);
        if (!nums.length) return [];
        
        const timestamp = values[values.length - 1][0];
        let value = nums[nums.length - 1];

        if (mode === "avg") {
          value = nums.reduce((sum, item) => sum + item, 0) / nums.length;
        } else if (mode === "sum") {
          value = nums.reduce((sum, item) => sum + item, 0);
        } else if (mode === "min") {
          value = Math.min(...nums);
        } else if (mode === "max") {
          value = Math.max(...nums);
        } else if (mode === "mode") {
          const counts = new Map();
          nums.forEach(item => {
            const rounded = Number(item.toFixed(2));
            counts.set(rounded, (counts.get(rounded) || 0) + 1);
          });
          value = [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? value;
        }

        if (["line", "area", "bar", "scatter"].includes(chartType)) {
          return values.map(v => [v[0], value]);
        }

        return [[timestamp, value]];
      }

      async function updateCardMode(select) {
        const card = select.closest(".card");
        const selects = card.querySelectorAll(".control-grid select");
        card.dataset.chartType = selects[0]?.value || "line";
        card.dataset.aggregation = selects[1]?.value || "none";
        fetch("/api/dashboard", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            query: card.dataset.query,
            metricId: card.dataset.metricId,
            chartType: card.dataset.chartType,
            aggregation: card.dataset.aggregation
          })
        }).catch(console.error);
        await refreshCard(card);
      }

      function toSafeISOString(dateStr) {
        if (!dateStr) return undefined;
        const d = new Date(dateStr);
        return isNaN(d.getTime()) ? undefined : d.toISOString();
      }

      async function refreshCard(card, forceFetch = true) {
        if (!card) {
          return;
        }

        const query = card.dataset.query;
        const chartId = card.dataset.chartId;
        const range = Number(card.dataset.range) || 300;

        if (!forceFetch && card.__latestData) {
          const { data, thresholdData } = card.__latestData;
          renderChart(chartId, data, query, range, thresholdData);
          return;
        }

        const startInputEl = card.querySelector(".card-start-input");
        const endInputEl = card.querySelector(".card-end-input");
        
        const startInput = startInputEl?.value;
        const endInput = endInputEl?.value;

        const rangeBtns = card.querySelectorAll(".range-btn");
        if (startInput || endInput) {
          rangeBtns.forEach(btn => btn.classList.remove("active"));
        } else {
          rangeBtns.forEach(btn => {
            const btnRange = Number(btn.dataset.range);
            btn.classList.toggle("active", btnRange === range);
          });
        }

        const startISO = toSafeISOString(startInput);
        const endISO = toSafeISOString(endInput);

        try {
          const res = await fetch("/api/query", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              query,
              range: (!startISO && !endISO) ? range : undefined,
              start: startISO || undefined,
              end: endISO || undefined,
              comparePrevious: false,
              machineId: window.selectedMachineId
            })
          });

          if (!res.ok) {
            const error = await res.json();
            console.error("Erro ao buscar dados:", error);
            const el = document.getElementById(chartId);
            if (el) {
              el.innerHTML = `<div class="empty-state">Erro ao carregar dados: ${error.error || 'Erro desconhecido'}</div>`;
            }
            return;
          }

          const payload = await res.json();
          const data = normalizeQueryPayload(payload, range);
          const thresholdData = await getThresholdByQuery(query);

          card.__latestData = { data, thresholdData };

          renderChart(chartId, data, query, range, thresholdData);
        } catch (err) {
          console.error("Erro em refreshCard:", err);
          const el = document.getElementById(chartId);
          if (el) {
            el.innerHTML = `<div class="empty-state">Erro ao processar dados</div>`;
          }
        }
      }

      async function changeRange(btn, range) {
        const card = btn.closest(".card");
        
        const startInputEl = card.querySelector(".card-start-input");
        const endInputEl = card.querySelector(".card-end-input");
        if (startInputEl) startInputEl.value = "";
        if (endInputEl) endInputEl.value = "";

        card.dataset.range = String(range);
        await refreshCard(card);
      }

      function renderChart(id, prometheusPayload, query, range = 300, thresholdData = null) {
        const el = document.getElementById(id);

        if (!el) {
          return;
        }

        const card = el.closest(".card");
        const chartType = card?.dataset.chartType || "line";
        const aggregation = card?.dataset.aggregation || "none";
        let chart = echarts.getInstanceByDom(el);

        const { series: prometheusData, start, end } = normalizeQueryPayload(prometheusPayload, range);
        const windowStart = Number(start) * 1000;
        const windowEnd = Number(end) * 1000;
        const firstPoint = prometheusData
          .flatMap(item => item.values || [])
          .map(item => Number(item[0]) * 1000)
          .filter(Number.isFinite)
          .sort((a, b) => a - b)[0];
        const windowLabel = card?.querySelector(".chart-window");

        if (windowLabel) {
          const selectedStart = new Date(windowStart).toLocaleString("pt-BR", {
            day: "2-digit",
            month: "2-digit",
            hour: "2-digit",
            minute: "2-digit"
          });
          const selectedEnd = new Date(windowEnd).toLocaleString("pt-BR", {
            day: "2-digit",
            month: "2-digit",
            hour: "2-digit",
            minute: "2-digit"
          });
          const coverage = firstPoint
            ? `dados desde ${new Date(firstPoint).toLocaleString("pt-BR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" })}`
            : "sem dados no intervalo";
          windowLabel.textContent = `${selectedStart} - ${selectedEnd} | ${coverage}`;
        }
        const maxPoints = prometheusData.reduce(
          (max, item) => Math.max(max, item.values?.length || 0),
          0
        );
        const unit = thresholdData?.unit || getMetricUnit(query);
        const series = prometheusData
          .filter(item => item.values?.length)
          .map((item, index) => ({
            name: resolveMetricName(query, prometheusData),
            type: chartType === "area" ? "line" : chartType,
            smooth: chartType !== "bar" && chartType !== "scatter",
            showSymbol: chartType === "scatter",
            sampling: maxPoints > 800 ? "lttb" : false,
            progressive: maxPoints > 800 ? 200 : 0,
            progressiveThreshold: 800,
            animationDuration: 400,
            animationEasing: "linear",
            lineStyle: {
              width: 2.5
            },
            areaStyle: chartType === "area" ? {
              opacity: .18
            } : undefined,
            data: aggregateValues(item.values, aggregation, chartType).map(v => [
              Number(v[0]) * 1000,
              parseFloat(v[1])
            ]),
            markLine: buildThresholdMarkLines(thresholdData)
          }));
        const comparisonSeries = (prometheusPayload.comparisonSeries || [])
          .filter(item => item.values?.length)
          .map(item => ({
            name: `${resolveMetricName(query, prometheusData)} periodo anterior`,
            type: "line",
            smooth: true,
            showSymbol: false,
            lineStyle: {
              width: 1.5,
              type: "dashed"
            },
            data: aggregateValues(item.values, aggregation, chartType).map(v => [
              Number(v[0]) * 1000 + ((windowEnd - windowStart) || 0),
              parseFloat(v[1])
            ])
          }));

        const latestValues = prometheusData
          .filter(item => item.values?.length)
          .map((item, index) => {
            const values = aggregateValues(item.values, aggregation, chartType);
            const last = values[values.length - 1];
            return {
              name: item.metric?.instance || item.metric?.device || item.metric?.__name__ || `Serie ${index + 1}`,
              value: Number(last?.[1] || 0)
            };
          });
        const latestValue = latestValues[0]?.value || 0;

        if (chartType === "stat") {
          chart?.dispose();
          el.innerHTML = `
            <div class="stat-card">
              <div class="stat-value">${formatValueWithUnit(latestValue, unit, "", query)}</div>
              <div class="stat-label">${resolveMetricName(query, prometheusData)}</div>
            </div>
          `;
          return;
        }

        if (el.querySelector(".stat-card")) {
          el.innerHTML = "";
        }

        chart = echarts.getInstanceByDom(el) || echarts.init(el);
        const light = document.body.dataset.theme === "light";
        const axisColor = light ? "#5d6f82" : "#a8b4c7";
        const splitColor = light ? "rgba(55,74,96,.13)" : "rgba(151,164,184,.1)";
        const tooltipBg = light ? "#ffffff" : "#0b1220";
        const tooltipText = light ? "#0f172a" : "#f7fbff";

        if (chartType === "gauge") {
          chart.setOption({
            color: ["#2dd4bf"],
            backgroundColor: "transparent",
            series: [{
              type: "gauge",
              min: 0,
              max: Math.max(100, Math.ceil(latestValue * 1.2)),
              progress: { show: true, width: 10 },
              axisLine: { lineStyle: { width: 10 } },
              pointer: { width: 4 },
              detail: {
                formatter: value => formatValueWithUnit(value, unit, "", query),
                color: axisColor,
                fontSize: 20,
                fontWeight: 800
              },
              data: [{ value: latestValue, name: resolveMetricName(query, prometheusData) }]
            }]
          }, true);
          setTimeout(() => chart.resize(), 0);
          return;
        }

        if (chartType === "pie") {
          chart.setOption({
            color: ["#2dd4bf", "#60a5fa", "#f59e0b", "#a78bfa", "#22c55e"],
            backgroundColor: "transparent",
            tooltip: {
              trigger: "item",
              backgroundColor: tooltipBg,
              borderColor: splitColor,
              borderWidth: 1,
              padding: [6, 10],
              textStyle: { color: tooltipText, fontSize: 11, fontFamily: "Inter, sans-serif" },
              formatter: item => `${item.name}: <strong>${formatValueWithUnit(item.value, unit, "", query)}</strong>`
            },
            series: [{
              type: "pie",
              radius: ["40%", "70%"],
              avoidLabelOverlap: true,
              data: latestValues.length ? latestValues : [{ name: resolveMetricName(query, prometheusData), value: 0 }]
            }]
          }, true);
          setTimeout(() => chart.resize(), 0);
          return;
        }

        // Clean & Simplified ECharts configuration with explicit units and minimal tooltip
        chart.setOption(
          {
            color: ["#2dd4bf", "#60a5fa", "#f59e0b", "#a78bfa", "#22c55e"],
            backgroundColor: "transparent",
            animation: true,
            animationDurationUpdate: 400,
            animationEasingUpdate: "linear",
            tooltip: {
              trigger: "axis",
              backgroundColor: tooltipBg,
              borderColor: splitColor,
              borderWidth: 1,
              padding: [6, 10],
              textStyle: {
                color: tooltipText,
                fontSize: 11,
                fontFamily: "Inter, sans-serif"
              },
              formatter: params => {
                if (!params || !params.length) return "";
                const d = new Date(params[0].value[0]);
                const timeStr = d.toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
                let html = `<div style="font-weight:700;margin-bottom:4px;color:${tooltipText};font-size:11px;">${timeStr}</div>`;
                params.forEach(p => {
                  if (p.value && p.value[1] !== undefined) {
                    const val = Number(p.value[1]);
                    const formatted = formatValueWithUnit(val, unit, p.seriesName, query);
                    html += `<div style="display:flex;align-items:center;gap:6px;margin-top:2px;">
                      <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:${p.color}"></span>
                      <span style="opacity:0.85">${p.seriesName || 'Valor'}:</span>
                      <strong style="color:${tooltipText}">${formatted}</strong>
                    </div>`;
                  }
                });
                return html;
              }
            },
            grid: {
              left: 42,
              right: 14,
              top: 24,
              bottom: 30
            },
            xAxis: {
              type: "time",
              min: windowStart,
              max: windowEnd,
              axisLine: {
                lineStyle: {
                  color: axisColor
                }
              },
              axisLabel: {
                color: axisColor,
                fontSize: 10,
                formatter: value => {
                  const d = new Date(value);
                  return d.toLocaleTimeString("pt-BR", {
                    hour: "2-digit",
                    minute: "2-digit"
                  });
                }
              }
            },
            yAxis: {
              type: "value",
              name: unit ? `(${unit})` : "",
              nameTextStyle: {
                color: axisColor,
                fontSize: 10,
                fontWeight: "bold",
                align: "right",
                padding: [0, 6, 0, 0]
              },
              axisPointer: {
                show: true
              },
              axisLine: {
                lineStyle: {
                  color: axisColor
                }
              },
              splitLine: {
                lineStyle: {
                  color: splitColor
                }
              },
              axisLabel: {
                color: axisColor,
                fontSize: 10,
                formatter: val => {
                  if (unit === "%") return `${val}%`;
                  if (unit === "B/s") return formatShortBytesRate(val);
                  return val;
                }
              }
            },
            series: [...series, ...comparisonSeries]
          },
          true
        );

        setTimeout(() => {
          chart.resize();
        }, 0);

        if (!window.__chartResizeBound) {
          window.addEventListener("resize", () => {
            document.querySelectorAll("[data-chart-id]").forEach(chartEl => {
              echarts.getInstanceByDom(chartEl)?.resize();
            });
          });

          window.__chartResizeBound = true;
        }
      }

      async function refreshAlertsEngine() {
        const cards = document.querySelectorAll(".card[data-query]");

        for (const card of cards) {
          try {
            await fetch("/api/query", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                query: card.dataset.query,
                range: 300,
                comparePrevious: false,
                machineId: window.selectedMachineId
              })
            });
          } catch (err) {
            console.error(err);
          }
        }
      }

      async function loadDashboards() {
        try {
          const res = await fetch("/api/dashboard");
          const dashboards = await res.json();
          const container = document.getElementById("chartsContainer");

          container.innerHTML = "";
          activeDashboards.clear();

          if (!dashboards.length) {
            container.innerHTML = emptyState("Nenhum dashboard criado ainda. Use o seletor acima para adicionar metricas.");
            document.getElementById("dashboardCount").textContent = "0";
            return;
          }

          document.getElementById("dashboardCount").textContent = String(dashboards.length);

          for (const d of dashboards) {
            await renderSavedChart(d);
          }
        } catch (err) {
          console.error(err);
        }
      }

      async function deleteAlert(id) {
        try {
          await fetch(`/api/alert/${id}`, {
            method: "DELETE"
          });

          await loadThresholds();
          await loadAlertFeed();
          await refreshCharts();
        } catch (err) {
          console.error(err);
        }
      }

      async function loadThresholds() {
        const res = await fetch("/api/alerts");

        if (!res.ok) {
          console.error("Erro alerts:", res.status);
          return [];
        }

        const alerts = await res.json();
        const thresholdList = document.getElementById("thresholdList");
        thresholdList.innerHTML = "";

        if (!alerts.length) {
          thresholdList.innerHTML = emptyState("Nenhum threshold ativo.");
          return;
        }

        alerts.forEach(alert => {
          const div = document.createElement("div");
          const { warningThreshold, criticalThreshold } = resolveThresholds(alert);
          const color = statusColor(alert.status);
          const unit = alert.unit || getMetricUnit(alert.query, "%");
          const emailsText = alert.notificationEmails ? `<br><span class="muted" style="font-size:10px;">E-mails: ${alert.notificationEmails}</span>` : '';

          div.className = `threshold-item status-${alert.status || "OK"}`;
          div.dataset.query = alert.query;
          div.innerHTML = `
            <div class="item-row">
              <div>
                <strong style="color:${color}">${alert.metricName}</strong><br>
                <span class="muted">Atual: ${formatValueWithUnit(alert.lastValue, unit, "", alert.query)}</span><br>
                <span class="muted">Atenção: ${formatNumber(warningThreshold)}${unit} | Alerta: ${formatNumber(criticalThreshold)}${unit}</span>${emailsText}<br>
                <span class="status-pill status-${alert.status}">${alert.status}</span>
              </div>
              <button class="delete-threshold-btn" title="Remover limites">X</button>
            </div>
          `;

          div.querySelector(".delete-threshold-btn").addEventListener("click", async () => {
            await deleteAlert(alert.id);
          });

          thresholdList.appendChild(div);
        });
      }

      async function loadAlertFeed() {
        const res = await fetch("/api/alerts");

        if (!res.ok) {
          console.error("Erro alerts:", res.status);
          return [];
        }

        const alerts = await res.json();
        const feed = document.getElementById("alertFeed");
        const activeAlerts = alerts.filter(a => a.status !== "OK");
        document.getElementById("activeAlertCount").textContent = String(activeAlerts.length);

        feed.innerHTML = "";

        if (!activeAlerts.length) {
          feed.innerHTML = emptyState("Sem alertas ativos no momento.");
          return;
        }

        activeAlerts.forEach(alert => {
          const div = document.createElement("div");
          const css = alert.status === "CRITICAL" ? "alert-critical" : "alert-warning";
          const unit = alert.unit || getMetricUnit(alert.query, "%");

          div.className = `alert-live ${css}`;
          div.innerHTML = `
            <strong>${alert.metricName}</strong><br>
            <span>Valor atual: ${formatValueWithUnit(alert.lastValue, unit, "", alert.query)}</span><br>
            <span class="muted">Threshold: ${formatNumber(alert.threshold)}${unit}</span>
          `;

          feed.appendChild(div);
        });
      }

      async function loadAlertLogs() {
        const res = await fetch("/api/alert-logs");
        const container = document.getElementById("logContainer");

        if (!res.ok) {
          container.innerHTML = emptyState("Nao foi possivel carregar os logs.");
          return;
        }

        const logs = await res.json();
        container.innerHTML = "";

        if (!logs.length) {
          container.innerHTML = emptyState("Nenhum alerta entrou em WARNING ou CRITICAL ainda.");
          return;
        }

        logs.forEach(log => {
          const div = document.createElement("div");
          const createdAt = new Date(log.createdAt).toLocaleString("pt-BR");
          const unit = log.unit || getMetricUnit(log.query, "%");

          div.className = "log";
          div.innerHTML = `
            <span class="status-pill status-${log.status}">${log.status}</span>
            <div>
              <strong>${log.metricName}</strong><br>
              <span class="muted">Valor ${formatValueWithUnit(log.value, unit, "", log.query)} / limite ${formatNumber(log.threshold)}${unit}</span>
            </div>
            <span class="muted">${createdAt}</span>
          `;

          container.appendChild(div);
        });
      }

      async function getThresholdByQuery(query) {
        try {
          const res = await fetch("/api/alerts");

          if (!res.ok) {
            return null;
          }

          const alerts = await res.json();
          const metricId = [...document.querySelectorAll(".card")]
            .find(c => c.dataset.query === query)
            ?.dataset.metricId;

          return alerts.find(a => a.query === query)
            || alerts.find(a => a.metricId === resolveMetricId(query, metricId));
        } catch (err) {
          console.error(err);
          return null;
        }
      }

      async function refreshCharts() {
        const cards = document.querySelectorAll(".card[data-query]");

        for (const card of cards) {
          const endInput = card.querySelector(".card-end-input")?.value;
          if (endInput) {
            continue;
          }
          await refreshCard(card);
        }
        await updateTrends();
      }

      async function updateTrends() {
        const cards = document.querySelectorAll(".card[data-query]");
        const trendContainer = document.getElementById("trendContainer");
        if (!cards.length) {
          trendContainer.innerHTML = emptyState("Crie dashboards para ver a análise de tendências.");
          return;
        }

        let trendsHtml = "";
        for (const card of cards) {
          const showTrend = card.dataset.showTrend !== "false";
          if (!showTrend) {
            continue;
          }

          const query = card.dataset.query;
          const name = card.querySelector("h4").textContent;
          
          try {
            const res = await fetch("/api/query", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                query,
                range: 3600,
                machineId: window.selectedMachineId
              })
            });
            const payload = await res.json();
            const series = payload.series || [];
            
            if (series.length > 0 && series[0].values?.length > 5) {
              const values = series[0].values.map(v => parseFloat(v[1]));
              const first = values[0];
              const last = values[values.length - 1];
              const diff = last - first;
              const percentChange = first !== 0 ? (diff / Math.abs(first)) * 100 : 0;
              
              const isUp = diff > 0;
              const color = isUp ? "#ef4444" : "#22c55e";
              const icon = isUp ? "↗" : "↘";
              const trendText = isUp ? "Tendência de Alta" : "Tendência de Queda";
              
              trendsHtml += `
                <div class="card" style="padding: 12px; border-left: 3px solid ${color}">
                  <div style="display: flex; justify-content: space-between; align-items: start;">
                    <div>
                      <h4 style="margin: 0; font-size: 12px;">${name}</h4>
                      <div class="muted" style="font-size: 10px;">Última 1 hora</div>
                    </div>
                    <div style="font-size: 18px; color: ${color}; font-weight: bold;">${icon}</div>
                  </div>
                  <div style="margin-top: 8px;">
                    <span style="font-size: 15px; font-weight: 800; color: ${color};">
                      ${percentChange > 0 ? "+" : ""}${percentChange.toFixed(1)}%
                    </span>
                    <span class="muted" style="margin-left: 6px; font-size: 11px;">${trendText}</span>
                  </div>
                  <div class="muted" style="font-size: 10px; margin-top: 6px;">
                    Variação de ${first.toFixed(2)} para ${last.toFixed(2)}
                  </div>
                </div>
              `;
            }
          } catch (e) { console.error(e); }
        }
        
        if (trendsHtml) {
          trendContainer.innerHTML = trendsHtml;
        } else {
          trendContainer.innerHTML = emptyState("Nenhum dashboard com análise de tendência habilitada ou dados insuficientes.");
        }
      }

      function toggleTrendAnalysis(btn) {
        const card = btn.closest(".card");
        const isShown = card.dataset.showTrend !== "false";
        card.dataset.showTrend = isShown ? "false" : "true";
        
        btn.style.opacity = isShown ? "0.5" : "1";
        btn.title = isShown ? "Análise de tendência desativada (clique para ativar)" : "Análise de tendência ativada (clique para desativar)";
        
        updateTrends();
      }

      async function loadMetricCatalog() {
        try {
          const res = await fetch("/api/metrics/catalog");

          if (!res.ok) {
            return;
          }

          const catalog = await res.json();
          metricList = catalog;
          renderMetricOptions();
        } catch (err) {
          console.error(err);
        }
      }

      function toggleTheme() {
        const nextTheme = document.body.dataset.theme === "light" ? "dark" : "light";
        document.body.dataset.theme = nextTheme;
        localStorage.setItem("temporal-series-theme", nextTheme);

        fetch("/api/preferences", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ theme: nextTheme })
        }).catch(console.error);

        // Atualiza as cores do tema nos gráficos de forma fluida sem sumir com os dados
        document.querySelectorAll(".card[data-query]").forEach(card => {
          refreshCard(card, false);
        });

        setTimeout(() => {
          document.querySelectorAll("[data-chart-id]").forEach(chartEl => {
            const chart = echarts.getInstanceByDom(chartEl);
            if (chart) {
              chart.resize();
            }
          });
        }, 50);
      }

      function updateRefreshInterval() {
        const input = document.getElementById("refreshIntervalInput");
        const interval = Number(input?.value) || 5000;
        localStorage.setItem("temporal-series-refresh", String(interval));
        document.getElementById("refreshSummary").textContent = formatInterval(interval);
        document.getElementById("refreshStatus").textContent = `Atualizacao automatica a cada ${formatInterval(interval)}.`;
        fetch("/api/preferences", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            theme: document.body.dataset.theme || "dark",
            refreshInterval: interval
          })
        }).catch(console.error);

        if (window.__chartRefreshTimer) {
          clearInterval(window.__chartRefreshTimer);
        }

        window.__chartRefreshTimer = setInterval(() => {
          refreshCharts();
        }, interval);
      }

      async function sendTestEmail() {
        const res = await fetch("/api/alerts/test-email", { method: "POST" });
        alert(res.ok ? "Email de teste solicitado." : "Nao foi possivel solicitar o email de teste.");
      }

      // Machine and Agent Token Management
      window.selectedMachineId = localStorage.getItem("temporal-series-machine") || "";

      function toggleTokenPanel() {
        const panel = document.getElementById("tokenPanel");
        panel.style.display = panel.style.display === "none" ? "block" : "none";
        if (panel.style.display === "block") {
          loadAgentToken();
        }
      }

      async function loadAgentToken() {
        try {
          const res = await fetch("/api/machine/token");
          if (res.ok) {
            const data = await res.json();
            document.getElementById("agentTokenCode").textContent = data.token;
          }
        } catch (err) {
          console.error("Erro ao carregar token:", err);
        }
      }

      async function generateNewToken() {
        if (!confirm("Tem certeza que deseja regerar o token? O token anterior parará de funcionar para novos registros.")) {
          return;
        }
        try {
          const res = await fetch("/api/machine/token", { method: "POST" });
          if (res.ok) {
            const data = await res.json();
            document.getElementById("agentTokenCode").textContent = data.token;
            alert("Novo token gerado com sucesso!");
          }
        } catch (err) {
          console.error("Erro ao gerar novo token:", err);
        }
      }

      function copyAgentToken() {
        const tokenText = document.getElementById("agentTokenCode").textContent;
        navigator.clipboard.writeText(tokenText).then(() => {
          alert("Token copiado com sucesso!");
        }).catch(err => {
          console.error("Erro ao copiar token:", err);
        });
      }

      async function loadUserMachines() {
        try {
          const res = await fetch("/api/machines");
          if (!res.ok) return;
          const machines = await res.json();
          const select = document.getElementById("machineSelect");
          select.innerHTML = "";

          if (!machines || !machines.length) {
            const opt = document.createElement("option");
            opt.value = "";
            opt.textContent = "Nenhum computador registrado";
            select.appendChild(opt);
            window.selectedMachineId = "";
            localStorage.removeItem("temporal-series-machine");
            return;
          }

          // Check if previously selected machine still exists in the list
          let selectedExists = machines.some(m => m.id === window.selectedMachineId);
          if (!selectedExists) {
            window.selectedMachineId = machines[0].id;
            localStorage.setItem("temporal-series-machine", window.selectedMachineId);
          }

          machines.forEach(machine => {
            const opt = document.createElement("option");
            opt.value = machine.id;
            opt.textContent = `${machine.hostname} (${machine.os} - ${machine.status})`;
            if (machine.id === window.selectedMachineId) {
              opt.selected = true;
            }
            select.appendChild(opt);
          });
        } catch (err) {
          console.error("Erro ao buscar computadores:", err);
        }
      }

      async function selectMachine(machineId) {
        window.selectedMachineId = machineId;
        localStorage.setItem("temporal-series-machine", machineId);
        await refreshCharts();
      }

      const savedTheme = localStorage.getItem("temporal-series-theme");

      if (savedTheme) {
        document.body.dataset.theme = savedTheme;
      }

      const savedRefresh = localStorage.getItem("temporal-series-refresh") || "5000";
      const refreshInput = document.getElementById("refreshIntervalInput");

      if (refreshInput) {
        refreshInput.value = savedRefresh;
      }

      setInterval(async () => {
        await loadThresholds();
        await loadAlertFeed();
        await loadAlertLogs();
      }, 5000);

      updateRefreshInterval();

      loadMetricCatalog();

      // Load machines and then load dashboards
      loadUserMachines().then(() => {
        loadDashboards();
        loadThresholds();
        loadAlertFeed();
        loadAlertLogs();
      });
    </script>
    <script src="/js/page-transition.js"></script>
  </body>
</html>
