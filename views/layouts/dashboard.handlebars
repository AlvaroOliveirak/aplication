              <div class="control-field">
                <label>Fim</label>
                <input class="card-end-input" type="datetime-local" onchange="refreshCard(this.closest('.card'))">
              </div>
              <div class="control-field">
                <label>Comparacao</label>
                <select class="card-compare-input" onchange="refreshCard(this.closest('.card'))">
                  <option value="false">Desativada</option>
                  <option value="true">Periodo anterior</option>
                </select>
              </div>
            </div>
            <div class="range-buttons">
              <button class="range-btn active" onclick="changeRange(this, 300)">5m</button>
              <button class="range-btn" onclick="changeRange(this, 3600)">1h</button>
              <button class="range-btn" onclick="changeRange(this, 10800)">3h</button>
              <button class="range-btn" onclick="changeRange(this, 43200)">12h</button>
              <button class="range-btn" onclick="changeRange(this, 86400)">24h</button>
            </div>
            <div id="${chartId}" data-chart-id="${chartId}" class="chart-box"></div>
            <div class="alert-inline">
              <form class="threshold-form">
                <legend>Zona verde abaixo do limite de atencao. Entre atencao e alerta: WARNING. Acima do alerta: CRITICAL.</legend>
                <div class="threshold-fields">
                  <div class="threshold-field">
                    <label class="warning-label" for="warning_${chartId}">Limite de atencao</label>
                    <input id="warning_${chartId}" class="thresholdInput warningInput" type="number" step="0.01" placeholder="Ex: 60" required>
                  </div>
                  <div class="threshold-field">
                    <label class="critical-label" for="critical_${chartId}">Limite de alerta</label>
                    <input id="critical_${chartId}" class="thresholdInput criticalInput" type="number" step="0.01" placeholder="Ex: 80" required>
                  </div>
